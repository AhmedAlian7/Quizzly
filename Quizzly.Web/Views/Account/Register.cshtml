@model RegisterViewModel

@{
    ViewData["Title"] = "Register";
}

<style>
    .divider:after,
    .divider:before {
        content: "";
        flex: 1;
        height: 1px;
        background: #eee;
    }
    .h-custom {
        height: calc(100% - 73px);
    }
</style>

<section class="vh-100">
    <div class="container-fluid h-custom">
        <div class="row d-flex justify-content-center align-items-center h-100">
            <div class="col-md-9 col-lg-6 col-xl-5">
                <img src="https://mdbcdn.b-cdn.net/img/Photos/new-templates/bootstrap-login-form/draw2.webp"
                     class="img-fluid" alt="Sample image">
            </div>
            <div class="col-md-8 col-lg-6 col-xl-4 offset-xl-1">
                <form asp-action="Register" asp-controller="Account" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <div class="d-flex flex-row align-items-center justify-content-center justify-content-lg-start">
                        <p class="lead fw-normal mb-0 me-3">Sign in with</p>
                        <a class="btn btn-primary btn-floating mx-1" href="@Url.Action("ExternalLogin","Account", new { provider = "Facebook", returnUrl = Url.Action("Index","Home") })" title="Continue with Facebook" aria-label="Continue with Facebook">
                            <!-- Facebook SVG icon -->
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 320 512" fill="currentColor" role="img" aria-hidden="true">
                                <path d="M279.14 288l14.22-92.66h-88.91V127.66c0-25.35 12.42-50.06 52.24-50.06H295V6.26S259.5 0 225.36 0c-73.22 0-121.08 44.38-121.08 124.72v70.62H22.89V288h81.39v224h100.17V288z"/>
                            </svg>
                        </a>
                        <a class="btn btn-primary btn-floating mx-1" href="@Url.Action("ExternalLogin","Account", new { provider = "LinkedIn", returnUrl = Url.Action("Index","Home") })" title="Continue with LinkedIn" aria-label="Continue with LinkedIn">
                            <!-- LinkedIn SVG icon -->
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 448 512" fill="currentColor" role="img" aria-hidden="true">
                                <path d="M100.28 448H7.4V148.9h92.88zm-46.44-340C24.5 108 0 83.5 0 53.64A53.64 53.64 0 0 1 53.64 0 53.64 53.64 0 0 1 107.28 53.64c0 29.86-24.5 54.36-54.44 54.36zM447.9 448h-92.6V302.4c0-34.7-.7-79.2-48.2-79.2-48.3 0-55.7 37.7-55.7 76.6V448h-92.6V148.9h88.9v40.8h1.3c12.4-23.6 42.6-48.5 87.7-48.5 93.8 0 111.1 61.8 111.1 142.3V448z"/>
                            </svg>
                        </a>
                    </div>

                    <div class="divider d-flex align-items-center my-4">
                        <p class="text-center fw-bold mx-3 mb-0">Or</p>
                    </div>

                    <!-- First Name input -->
                    <div class="form-outline mb-4">
                        <label asp-for="FirstName" class="form-label"></label>
                        <input asp-for="FirstName" class="form-control form-control-lg" placeholder="Enter your first name" />
                        <span asp-validation-for="FirstName" class="text-danger"></span>
                    </div>

                    <!-- Last Name input -->
                    <div class="form-outline mb-4">
                        <label asp-for="LastName" class="form-label"></label>
                        <input asp-for="LastName" class="form-control form-control-lg" placeholder="Enter your last name" />
                        <span asp-validation-for="LastName" class="text-danger"></span>
                    </div>

                    <!-- Email input -->
                    <div class="form-outline mb-4">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control form-control-lg" placeholder="Enter a valid email address" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <!-- Password input -->
                    <div class="form-outline mb-3">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" class="form-control form-control-lg" placeholder="Enter password" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <!-- Confirm Password input -->
                    <div class="form-outline mb-3">
                        <label asp-for="ConfirmPassword" class="form-label"></label>
                        <input asp-for="ConfirmPassword" class="form-control form-control-lg" placeholder="Confirm password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>

                    <!-- Role Selection for All Users -->
                    <div class="aura-input-group mb-3">
                        <label asp-for="Role" class="form-label">Select Role</label>
                        <div class="position-relative">
                            <span class="aura-input-icon icon-user"></span>
                            <select asp-for="Role" asp-items="@Model.RolesList" class="form-select role-select" required>
                                <option disabled selected>-- Select Role --</option>
                            </select>
                        </div>
                        <span asp-validation-for="Role" class="text-danger"></span>
                    </div>

                    <!-- Instructor Title (if role is Instructor) -->
                    <div class="form-outline mb-3" id="instructorTitleDiv" style="display:none;">
                        <label asp-for="InstructorTitle" class="form-label"></label>
                        <input asp-for="InstructorTitle" class="form-control form-control-lg" placeholder="Title (e.g., Professor, Lecturer)" />
                        <span asp-validation-for="InstructorTitle" class="text-danger"></span>
                    </div>

                    <!-- Student Number (if role is Student) -->
                    <div class="form-outline mb-3" id="studentNumberDiv" style="display:none;">
                        <label asp-for="StudentNumber" class="form-label"></label>
                        <input asp-for="StudentNumber" class="form-control form-control-lg" placeholder="Student Number" />
                        <span asp-validation-for="StudentNumber" class="text-danger"></span>
                    </div>

                    <div class="form-check mb-3">
                        <input asp-for="AcceptTerms" class="form-check-input me-2" />
                        <label asp-for="AcceptTerms" class="form-check-label"></label>
                        <span asp-validation-for="AcceptTerms" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center">
                        <a href="#!" class="text-body">Forgot password?</a>
                    </div>

                    <div class="text-center text-lg-start mt-4 pt-2">
                        <button type="submit" class="btn btn-primary btn-lg"
                                style="padding-left: 2.5rem; padding-right: 2.5rem;">
                            Register
                        </button>
                        <p class="small fw-bold mt-2 pt-1 mb-0">
                            Already have an account? <a href="/Account/Login" class="link-danger">Login</a>
                        </p>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Show/hide InstructorTitle and StudentNumber fields based on Role selection
        document.addEventListener('DOMContentLoaded', function () {
            var roleSelect = document.querySelector('[name="Role"]');
            var instructorDiv = document.getElementById('instructorTitleDiv');
            var studentDiv = document.getElementById('studentNumberDiv');
            function toggleRoleFields() {
                if (!roleSelect) return;
                var value = roleSelect.value;
                instructorDiv.style.display = value === 'Instructor' ? '' : 'none';
                studentDiv.style.display = value === 'Student' ? '' : 'none';
            }
            if (roleSelect) {
                roleSelect.addEventListener('change', toggleRoleFields);
                toggleRoleFields();
            }
        });
    </script>
}