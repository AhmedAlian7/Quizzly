@using Quizzly.Business.ViewModels.QuizCategories
@model IEnumerable<AddQuizCategoryDto>

@{
    ViewData["Title"] = "Quizzes";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0">Quizzes</h2>
            <p class="text-muted">Select a category to view and manage quizzes</p>
        </div>
        <a asp-controller="QuizManagement" asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus"></i> Create New Quiz
        </a>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row g-4">
            @foreach (var category in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <a asp-action="QuizzesByCategory" asp-route-CategoryId="@category.Id" class="text-decoration-none">
                        <div class="card h-100 shadow-sm category-card">
                            <div class="card-body">
                                <div class="d-flex align-items-start mb-3">
                                    <div class="flex-grow-1">
                                        <h5 class="card-title fw-bold mb-2">@category.Name</h5>
                                        @if (!string.IsNullOrEmpty(category.Description))
                                        {
                                            <p class="card-text text-muted small mb-0">@category.Description</p>
                                        }
                                        else
                                        {
                                            <p class="card-text text-muted small mb-0">No description available</p>
                                        }
                                    </div>
                                    <i class="bi bi-folder fs-3 text-primary ms-2"></i>
                                </div>
                                <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                                    <span class="text-muted small">View Quizzes</span>
                                    <i class="bi bi-arrow-right-circle text-primary"></i>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">
                <i class="bi bi-folder-x fs-1 mb-3 d-block text-muted"></i>
                <h5>No Categories Found</h5>
                <p class="text-muted">You haven't created any quiz categories yet.</p>
                <a asp-controller="QuizCategoryManagement" asp-action="Create" class="btn btn-primary mt-3">
                    <i class="bi bi-plus"></i> Create Your First Category
                </a>
            </div>
        </div>
    }
</div>

<style>
    .category-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        cursor: pointer;
        border: 1px solid #e0e0e0;
    }

        .category-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
        }

        .category-card .card-title {
            color: #212529;
        }

        .category-card:hover .card-title {
            color: #0d6efd;
        }
</style>