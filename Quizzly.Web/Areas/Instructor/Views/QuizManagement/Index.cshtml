@using Quizzly.Business.ViewModels.Instructor
@model IEnumerable<InstructorAllQuizzesDto>

@{
    ViewData["Title"] = "Quiz Management";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0">Quiz Management</h2>
            <p class="text-muted">Create, edit, and manage your quizzes</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus"></i> Create New Quiz
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <h5 class="mb-3">Your Quizzes</h5>

            <div class="input-group mb-4">
                <span class="input-group-text bg-light border-0">
                    <i class="bi bi-search"></i>
                </span>
                <input type="text" id="quizSearch" class="form-control border-0" placeholder="Search quizzes...">
            </div>

            <table class="table align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Title</th>
                        <th>Status</th>
                        <th>Created</th>
                        <th>Questions</th>
                        <th>Attempts</th>
                        <th>Avg Score</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="quizTableBody">
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var quiz in Model)
                        {
                            <tr id="quiz-row-@quiz.Id">
                                <td>
                                    <div class="fw-semibold">@quiz.Title</div>
                                    <div class="text-muted small">@quiz.TimeLimit min time limit</div>
                                </td>
                                <td>
                                    @if (quiz.IsPublished)
                                    {
                                        <span class="badge bg-primary">Published</span>
                                    }
                                    else if (quiz.Attempts == 0)
                                    {
                                        <span class="badge bg-secondary">Draft</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-dark">Archived</span>
                                    }
                                </td>
                                <td>@quiz.CreatedAt.ToString("yyyy-MM-dd")</td>
                                <td>@quiz.Questions</td>
                                <td>@quiz.Attempts</td>
                                <td>@(quiz.AvgScore.HasValue ? $"{quiz.AvgScore.Value:F3}%" : "-")</td>
                                <td>
                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-light" data-bs-toggle="dropdown">
                                            <i class="bi bi-three-dots-vertical"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end">
                                            <li>
                                                <a class="dropdown-item" asp-action="Details" asp-route-id="@quiz.Id">Details</a>
                                            </li>
                                            <li>
                                                <a class="dropdown-item" asp-action="Update" asp-route-id="@quiz.Id">Edit</a>
                                            </li>
                                            <li>
                                                <button type="button" class="dropdown-item text-danger" onclick="confirmDelete(@quiz.Id, '@quiz.Title')">
                                                    Delete
                                                </button>
                                            </li>
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 mb-3 d-block"></i>
                                <h5>No quizzes found</h5>
                                <p>You haven’t created any quizzes yet.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">Confirm Delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="deleteModalBody">
                Are you sure you want to delete this quiz?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form id="deleteForm" method="post" asp-action="Delete" asp-controller="QuizManagement" asp-area="Instructor">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="quizIdToDelete" name="quizId" />
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash"></i> Delete Quiz
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('quizSearch').addEventListener('input', function () {
            const filter = this.value.toLowerCase();
            const rows = document.querySelectorAll('#quizTableBody tr');
            rows.forEach(row => {
                const title = row.querySelector('td:first-child').innerText.toLowerCase();
                row.style.display = title.includes(filter) ? '' : 'none';
            });
        });

        function confirmDelete(quizId, quizTitle) {
            document.getElementById('quizIdToDelete').value = quizId;
            document.getElementById('deleteModalBody').innerHTML =
                `Are you sure you want to delete the quiz <strong>${quizTitle}</strong>? This action cannot be undone.`;
            const modal = new bootstrap.Modal(document.getElementById('deleteModal'));
            modal.show();
        }
    </script>
}
