@using System.Text.Json
@using Quizzly.Business.ViewModels.Quiz
@model QuizDetailsDto
@{
    ViewData["Title"] = "Quiz Details";
}

<div class="container mt-5">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-primary">@Model.Title</h2>
        <div>
            <a href="@Url.Action("Index")" class="btn btn-secondary">Back to List</a>
            <a href="@Url.Action("Update", new { id = Model.Id })" class="btn btn-primary">Edit Quiz</a>

            @if (Model.IsPublished && !string.IsNullOrEmpty(Model.AccessCode))
            {
                <a href="/Instructor/QuizManagement/Token?token=@Model.AccessCode" class="btn btn-success ms-2">
                    <i class="fas fa-external-link-alt"></i> Go to Quiz
                </a>
            }
        </div>
    </div>

    <!-- Quiz Status & Access Code -->
    <div class="alert @(Model.IsPublished ? "alert-success" : "alert-warning") mb-4">
        <div class="d-flex justify-content-between align-items-center">
            <span>
                <strong>Status:</strong> @(Model.IsPublished ? "Published" : "Draft")
                @if (Model.IsPublished && !string.IsNullOrEmpty(Model.AccessCode))
                {
                    <span class="ms-3">
                        <strong>Access Code:</strong>
                        <code class="fs-5 mx-2">@Model.AccessCode</code>
                        <button type="button" class="btn btn-sm btn-outline-primary" onclick="copyAccessCode(event)">
                            <i class="fas fa-copy"></i> Copy
                        </button>
                    </span>
                }
            </span>
        </div>
    </div>

    <div class="row">
        <!-- Left Column - Quiz Details -->
        <div class="col-lg-8">
            <!-- Basic Information -->
            <div class="card mb-4">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Quiz Information</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <p><strong>Description:</strong> @(string.IsNullOrEmpty(Model.Description) ? "No description" : Model.Description)</p>
                            <p><strong>Time Limit:</strong> @Model.TimeLimit minutes</p>
                            <p>
                                <strong>Category:</strong>
                                @{
                                    var category = Model.Categories?.FirstOrDefault(c => c.Value == Model.CategoryId.ToString());
                                    @(category?.Text ?? "Unknown")
                                }
                            </p>
                        </div>
                        <div class="col-md-6">
                            <p><strong>Start Date:</strong> @Model.StartAt?.ToString("MMM dd, yyyy HH:mm")</p>
                            <p><strong>End Date:</strong> @Model.EndAt?.ToString("MMM dd, yyyy HH:mm")</p>
                            <p><strong>Passing Score:</strong> @(Model.PassingScore?.ToString("0.0") + "%" ?? "Not set")</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Questions -->
            <div class="card mb-4">
                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Questions (@Model.Questions.Count)</h5>
                </div>
                <div class="card-body">
                    @for (int i = 0; i < Model.Questions.Count; i++)
                    {
                        var question = Model.Questions[i];
                        <div class="question-item mb-4 pb-3 border-bottom">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h6 class="mb-0">Question @(i + 1) <span class="badge bg-secondary">@question.Points points</span></h6>
                                <span class="badge @GetQuestionTypeBadge(question.QuestionType)">@question.QuestionType</span>
                            </div>

                            <p class="mb-2">@question.Text</p>

                            <div class="mb-2">
                                <span class="badge @(question.IsRequired ? "bg-success" : "bg-secondary") me-2">
                                    @(question.IsRequired ? "Required" : "Optional")
                                </span>
                                <span class="badge @(question.AutoGrade ? "bg-primary" : "bg-warning")">
                                    @(question.AutoGrade ? "Auto-graded" : "Manual Grade")
                                </span>
                            </div>

                            @if (!string.IsNullOrEmpty(question.ImageUrl))
                            {
                                <div class="mb-3">
                                    <img src="@question.ImageUrl" alt="Question Image" style="max-height: 200px;" class="img-thumbnail" />
                                </div>
                            }

                            @if (question.QuestionType != Quizzly.DataAccess.Enums.QuestionType.ShortAnswer &&
                                                    question.QuestionType != Quizzly.DataAccess.Enums.QuestionType.Essay &&
                                                    question.Choices.Any())
                            {
                                <div class="choices-list">
                                    @foreach (var choice in question.Choices)
                                    {
                                        <div class="form-check mb-2">
                                            <input class="form-check-input" type="@(question.QuestionType == Quizzly.DataAccess.Enums.QuestionType.MCQ ? "checkbox" : "radio")"
                                                   @(choice.IsCorrect ? "checked" : "") disabled />
                                            <label class="form-check-label @(choice.IsCorrect ? "text-success fw-bold" : "")">
                                                @choice.Text
                                                @if (choice.IsCorrect)
                                                {
                                                    <span class="badge bg-success ms-2">Correct</span>
                                                }
                                            </label>
                                        </div>
                                    }
                                </div>
                            }
                            else if (question.QuestionType == Quizzly.DataAccess.Enums.QuestionType.ShortAnswer)
                            {
                                <div class="alert alert-info mb-0">
                                    <small>
                                        <strong>Short Answer Question:</strong><br />
                                        @if (question.Choices.Any())
                                        {
                                            <span>Correct answer: <strong>@question.Choices.First().Text</strong></span>
                                        }
                                        else
                                        {
                                            <span>No correct answer defined.</span>
                                        }
                                    </small>
                                </div>
                            }
                            else if (question.QuestionType == Quizzly.DataAccess.Enums.QuestionType.Essay)
                            {
                                <div class="alert alert-warning mb-0">
                                    <small><strong>Essay Question:</strong></small>
                                    <div class="mt-2">
                                        <label class="form-label fw-semibold">Model Answer (Optional)</label>
                                        <textarea class="form-control" rows="3" readonly>@question.Choices.FirstOrDefault()?.Text</textarea>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Right Column - Settings & Analytics -->
        <div class="col-lg-4">
            <div class="card mb-4">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Quiz Settings</h5>
                </div>
                <div class="card-body">
                    <div class="settings-list">
                        <div class="d-flex justify-content-between mb-2">
                            <span>Shuffle Questions:</span>
                            <span class="badge @(Model.ShuffleQuestions ? "bg-success" : "bg-secondary")">
                                @(Model.ShuffleQuestions ? "Yes" : "No")
                            </span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Shuffle Choices:</span>
                            <span class="badge @(Model.ShuffleChoices ? "bg-success" : "bg-secondary")">
                                @(Model.ShuffleChoices ? "Yes" : "No")
                            </span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Multiple Attempts:</span>
                            <span class="badge @(Model.AllowMultipleAttempts ? "bg-success" : "bg-secondary")">
                                @(Model.AllowMultipleAttempts ? "Yes" : "No")
                            </span>
                        </div>
                        @if (Model.AllowMultipleAttempts && Model.MaxAttempts.HasValue)
                        {
                            <div class="d-flex justify-content-between mb-2">
                                <span>Max Attempts:</span>
                                <span class="badge bg-info">@Model.MaxAttempts.Value</span>
                            </div>
                        }
                        <div class="d-flex justify-content-between mb-2">
                            <span>Auto Graded:</span>
                            <span class="badge @(Model.IsAutoGraded ? "bg-success" : "bg-secondary")">
                                @(Model.IsAutoGraded ? "Yes" : "No")
                            </span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Show Correct Answers:</span>
                            <span class="badge @(Model.ShowCorrectAnswers ? "bg-success" : "bg-secondary")">
                                @(Model.ShowCorrectAnswers ? "Yes" : "No")
                            </span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span>Show Score Immediately:</span>
                            <span class="badge @(Model.ShowScoreImmediatlely ? "bg-success" : "bg-secondary")">
                                @(Model.ShowScoreImmediatlely ? "Yes" : "No")
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Analytics -->
            @if (Model.IsPublished)
            {
                <div class="card">
                    <div class="card-header bg-light">
                        <h5 class="mb-0">Quiz Analytics</h5>
                    </div>
                    <div class="card-body">
                        @if (Model.AverageQuizTime.HasValue)
                        {
                            <div class="mb-3">
                                <strong>Average Completion Time:</strong><br />
                                <span class="text-primary">@Model.AverageQuizTime.Value.ToString(@"hh\:mm\:ss")</span>
                            </div>
                        }

                        @if (Model.QuestionPerformances?.Any() == true)
                        {
                            <div class="mb-3">
                                <strong>Question Performance:</strong>
                                <div class="mt-2">
                                    @foreach (var perf in Model.QuestionPerformances.Take(3))
                                    {
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <small class="text-truncate" style="max-width: 70%;" title="@perf.QuestionText">
                                                @perf.QuestionText
                                            </small>
                                            <small class="@(perf.PercentCorrect >= 70 ? "text-success" : perf.PercentCorrect >= 50 ? "text-warning" : "text-danger")">
                                                @perf.PercentCorrect.ToString("0.0")%
                                            </small>
                                        </div>
                                    }
                                    @if (Model.QuestionPerformances.Count > 3)
                                    {
                                        <small class="text-muted">+ @(Model.QuestionPerformances.Count - 3) more questions</small>
                                    }
                                </div>
                            </div>
                        }

                        @if (Model.StudentScoreDistributions?.Any() == true)
                        {
                            <div>
                                <strong>Score Distribution:</strong>
                                <div class="mt-3">
                                    <canvas id="scoreDistributionChart" height="180"></canvas>
                                </div>

                                <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
                                <script>
                                    document.addEventListener("DOMContentLoaded", function () {
                                        const ctx = document.getElementById('scoreDistributionChart');

                                        const labels = @Html.Raw(JsonSerializer.Serialize(
                                                                                Model.StudentScoreDistributions.Select(d => $"{d.RangeStart}-{d.RangeEnd}")
                                                                        ));

                                const data = @Html.Raw(JsonSerializer.Serialize(
                                                                        Model.StudentScoreDistributions.Select(d => d.StudentCount)
                                                                ));

                                new Chart(ctx, {
                                    type: 'bar',
                                    data: {
                                        labels: labels,
                                        datasets: [{
                                            label: 'Students',
                                            data: data,
                                            borderWidth: 1,
                                            backgroundColor: 'rgba(54, 162, 235, 0.6)',
                                            borderColor: 'rgba(54, 162, 235, 1)',
                                            borderRadius: 6
                                        }]
                                    },
                                    options: {
                                        responsive: true,
                                        maintainAspectRatio: false,
                                        plugins: { legend: { display: false } },
                                        scales: {
                                            x: {
                                                grid: { display: false },
                                                title: { display: true, text: 'Score Range' }
                                            },
                                            y: {
                                                beginAtZero: true,
                                                ticks: { stepSize: 1 },
                                                title: { display: true, text: 'Number of Students' }
                                            }
                                        }
                                    }
                                });
                            });
                        </script>
                    </div>
                                        }

                        @if ((Model.QuestionPerformances?.Any() != true) && (Model.StudentScoreDistributions?.Any() != true))
                        {
                            <div class="text-center text-muted">
                                <small>No analytics data available yet</small>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function copyAccessCode(event) {
            const accessCode = '@Model.AccessCode';
            navigator.clipboard.writeText(accessCode).then(() => {
                const originalText = event.target.innerHTML;
                event.target.innerHTML = '<i class="fas fa-check"></i> Copied!';
                event.target.classList.remove('btn-outline-primary');
                event.target.classList.add('btn-success');
                setTimeout(() => {
                    event.target.innerHTML = originalText;
                    event.target.classList.remove('btn-success');
                    event.target.classList.add('btn-outline-primary');
                }, 2000);
            }).catch(err => {
                console.error('Failed to copy access code:', err);
                alert('Copy failed. Please copy manually.');
            });
        }
    </script>
}

@functions {
    private string GetQuestionTypeBadge(Quizzly.DataAccess.Enums.QuestionType questionType)
    {
        return questionType switch
        {
            Quizzly.DataAccess.Enums.QuestionType.MCQ => "bg-primary",
            Quizzly.DataAccess.Enums.QuestionType.TrueFalse => "bg-info",
            Quizzly.DataAccess.Enums.QuestionType.ShortAnswer => "bg-warning",
            Quizzly.DataAccess.Enums.QuestionType.Essay => "bg-secondary",
            _ => "bg-secondary"
        };
    }
}
