@using Quizzly.Business.ViewModels.Quiz
@model AddQuizDto

@{
    ViewData["Title"] = "Create Quiz";
}

<div class="container mt-4 mb-5">
    <h2 class="mb-4 fw-bold text-primary">Create New Quiz</h2>

    <form asp-action="Create" method="post" enctype="multipart/form-data" id="quizForm" class="bg-white p-4 rounded shadow-sm border">
        @Html.AntiForgeryToken()

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Title" class="form-label fw-semibold"></label>
                <input asp-for="Title" class="form-control" placeholder="Enter quiz title..." required />
                <span asp-validation-for="Title" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="TimeLimit" class="form-label fw-semibold"></label>
                <input asp-for="TimeLimit" type="number" class="form-control" min="1" max="180" placeholder="Time in minutes" required />
                <span asp-validation-for="TimeLimit" class="text-danger small"></span>
            </div>

            <div class="col-md-12">
                <label asp-for="Description" class="form-label fw-semibold"></label>
                <textarea asp-for="Description" class="form-control" rows="3" placeholder="Write a short description..."></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="CategoryId" class="form-label fw-semibold"></label>
                <select asp-for="CategoryId" asp-items="Model.Categories" class="form-select" required>
                    <option value="">-- Select Category --</option>
                </select>
                <span asp-validation-for="CategoryId" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="PassingScore" class="form-label fw-semibold"></label>
                <input asp-for="PassingScore" type="number" step="0.1" class="form-control" placeholder="Enter passing score %" />
                <span asp-validation-for="PassingScore" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="StartAt" class="form-label fw-semibold"></label>
                <input asp-for="StartAt" type="datetime-local" class="form-control" />
                <span asp-validation-for="StartAt" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="EndAt" class="form-label fw-semibold"></label>
                <input asp-for="EndAt" type="datetime-local" class="form-control" />
                <span asp-validation-for="EndAt" class="text-danger small"></span>
            </div>
        </div>

        <hr class="my-4" />

        <h4 class="mb-3 fw-bold text-secondary">Quiz Settings</h4>
        <div class="row gy-2">
            <div class="col-md-4 form-check form-switch">
                <input asp-for="ShuffleQuestions" class="form-check-input" type="checkbox" value="true" />
                <label asp-for="ShuffleQuestions" class="form-check-label fw-semibold"></label>
            </div>

            <div class="col-md-4 form-check form-switch">
                <input asp-for="ShuffleChoices" class="form-check-input" type="checkbox" value="true" />
                <label asp-for="ShuffleChoices" class="form-check-label fw-semibold"></label>
            </div>

            <div class="col-md-4 form-check form-switch">
                <input asp-for="AllowMultipleAttempts" class="form-check-input" type="checkbox" value="true" id="allowAttemptsSwitch" />
                <label asp-for="AllowMultipleAttempts" class="form-check-label fw-semibold"></label>
            </div>

            <div class="col-md-4 form-check form-switch">
                <input asp-for="ShowCorrectAnswers" class="form-check-input" type="checkbox" value="true" />
                <label asp-for="ShowCorrectAnswers" class="form-check-label fw-semibold"></label>
            </div>

            <div class="col-md-4 form-check form-switch">
                <input asp-for="ShowScoreImmediatlely" class="form-check-input" type="checkbox" value="true" />
                <label asp-for="ShowScoreImmediatlely" class="form-check-label fw-semibold"></label>
            </div>
        </div>

        <div class="col-md-6 mt-3" id="maxAttemptsField" style="display: none;">
            <label asp-for="MaxAttempts" class="form-label fw-semibold"></label>
            <input asp-for="MaxAttempts" type="number" class="form-control" placeholder="e.g., 3" min="1" max="5" />
            <span asp-validation-for="MaxAttempts" class="text-danger small"></span>
        </div>

        <hr class="my-4" />

        <h4 class="fw-bold text-secondary mb-3">Questions</h4>

        <div id="questionsContainer"></div>

        <div class="mb-3">
            <button type="button" class="btn btn-outline-primary rounded-pill" onclick="addQuestion()">
                <i class="fas fa-plus-circle me-1"></i> Add Question
            </button>
        </div>

        <hr class="my-4" />

        <div class="d-flex justify-content-end gap-3">
            <a asp-action="Index" class="btn btn-outline-secondary px-5 rounded-pill">
                Cancel
            </a>
            <button type="submit" name="formAction" value="save" class="btn btn-outline-primary px-5 rounded-pill">
                Save Draft
            </button>
            <button type="submit" name="formAction" value="publish" class="btn btn-primary px-5 rounded-pill">
                Publish Quiz
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        let questionCount = 0;

        // Show/hide max attempts field
        document.getElementById('allowAttemptsSwitch').addEventListener('change', function () {
            document.getElementById('maxAttemptsField').style.display = this.checked ? 'block' : 'none';
        });

        function addQuestion() {
            questionCount++;

            const questionHtml = `
                <div class="border rounded p-3 mb-3 bg-light question-block" id="question-${questionCount}">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="fw-bold mb-0">Question ${questionCount}</h6>
                        <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeQuestion(${questionCount})">
                            <i class="fas fa-times-circle"></i> Remove
                        </button>
                    </div>

                    <div class="mb-2">
                        <label class="form-label">Question Text *</label>
                        <input name="addQuestionDtos[${questionCount - 1}].Text" class="form-control" placeholder="Enter question text..." required />
                    </div>

                    <div class="mb-2">
                        <label class="form-label">Points *</label>
                        <input name="addQuestionDtos[${questionCount - 1}].Points" type="number" step="0.5" min="1" max="100" class="form-control" placeholder="Points for this question" value="1" required />
                    </div>

                    <div class="mb-2">
                        <label class="form-label">Question Type *</label>
                        <select name="addQuestionDtos[${questionCount - 1}].QuestionType" class="form-select" onchange="toggleChoices(this, ${questionCount})" required>
                            <option value="0">Multiple Choice</option>
                            <option value="1">True / False</option>
                            <option value="2">Short Answer</option>
                            <option value="3">Essay</option>
                        </select>
                    </div>

                    <div class="mb-2">
                        <label class="form-label">Image (Optional)</label>
                        <input name="addQuestionDtos[${questionCount - 1}].ImageFile" type="file" class="form-control" accept="image/*" />
                    </div>

                    <div class="mb-2 form-check form-switch">
                        <input name="addQuestionDtos[${questionCount - 1}].IsRequired" class="form-check-input" type="checkbox" value="true" checked />
                        <label class="form-check-label fw-semibold">Is Required</label>
                    </div>

                    <div class="autograde-container" id="autograde-container-${questionCount}"></div>

                    <div class="choices-container" id="choices-${questionCount}">
                        ${getChoiceInputs(questionCount)}
                    </div>

                    <div class="text-end mt-2" id="addChoiceBtn-${questionCount}">
                        <button type="button" class="btn btn-sm btn-outline-primary" onclick="addChoice(${questionCount})">
                            <i class="fas fa-plus-circle"></i> Add Choice
                        </button>
                    </div>
                </div>
            `;

            document.getElementById("questionsContainer").insertAdjacentHTML("beforeend", questionHtml);
        }

        function getChoiceInputs(qId) {
            return `
                <div id="choices-list-${qId}">
                    ${getChoiceRow(qId, 0)}
                    ${getChoiceRow(qId, 1)}
                </div>
            `;
        }

        function getChoiceRow(qId, cIndex) {
            return `
                <div class="input-group mb-2 choice-row" id="choice-${qId}-${cIndex}">
                    <div class="input-group-text">
                        <input type="checkbox" name="addQuestionDtos[${qId - 1}].Choices[${cIndex}].IsCorrect" value="true" class="form-check-input mt-0" />
                    </div>
                    <input name="addQuestionDtos[${qId - 1}].Choices[${cIndex}].Text" class="form-control" placeholder="Choice ${cIndex + 1}" required />
                    <button type="button" class="btn btn-outline-danger" onclick="removeChoice(${qId}, ${cIndex})">
                        <i class="fas fa-minus-circle"></i>
                    </button>
                </div>
            `;
        }

        function addChoice(qId) {
            const container = document.getElementById(`choices-list-${qId}`);
            const index = container.querySelectorAll('.choice-row').length;
            container.insertAdjacentHTML("beforeend", getChoiceRow(qId, index));
        }

        function removeChoice(qId, cIndex) {
            const choice = document.getElementById(`choice-${qId}-${cIndex}`);
            if (choice) choice.remove();
            reindexChoices(qId);
        }

        function reindexChoices(qId) {
            const rows = document.querySelectorAll(`#choices-list-${qId} .choice-row`);
            rows.forEach((row, i) => {
                row.id = `choice-${qId}-${i}`;
                const checkbox = row.querySelector('input[type="checkbox"]');
                const text = row.querySelector('input.form-control');

                checkbox.name = `addQuestionDtos[${qId - 1}].Choices[${i}].IsCorrect`;
                checkbox.value = "true";
                text.name = `addQuestionDtos[${qId - 1}].Choices[${i}].Text`;
                text.placeholder = `Choice ${i + 1}`;
            });
        }

        function toggleChoices(select, qId) {
            const container = document.getElementById(`choices-${qId}`);
            const addBtn = document.getElementById(`addChoiceBtn-${qId}`);
            const autoGradeContainer = document.getElementById(`autograde-container-${qId}`);

            // Clear auto grade container first
            if (autoGradeContainer) {
                autoGradeContainer.innerHTML = '';
            }

            const questionType = parseInt(select.value);

            if (questionType === 0) { // Multiple Choice
                container.innerHTML = getChoiceInputs(qId);
                addBtn.style.display = 'block';
            } else if (questionType === 1) { // True/False
                container.innerHTML = `
                    <div id="choices-list-${qId}">
                        <div class="input-group mb-2 choice-row">
                            <div class="input-group-text">
                                <input type="checkbox" name="addQuestionDtos[${qId - 1}].Choices[0].IsCorrect" value="true" class="form-check-input mt-0" checked />
                            </div>
                            <input name="addQuestionDtos[${qId - 1}].Choices[0].Text" class="form-control" value="True" readonly />
                        </div>
                        <div class="input-group mb-2 choice-row">
                            <div class="input-group-text">
                                <input type="checkbox" name="addQuestionDtos[${qId - 1}].Choices[1].IsCorrect" value="true" class="form-check-input mt-0" />
                            </div>
                            <input name="addQuestionDtos[${qId - 1}].Choices[1].Text" class="form-control" value="False" readonly />
                        </div>
                    </div>
                `;
                addBtn.style.display = 'none';
            } else if (questionType === 2) { // Short Answer
                // Add Auto Grade checkbox to dedicated container
                autoGradeContainer.innerHTML = `
                    <div class="d-inline-flex align-items-center gap-2 border border-2 border-primary rounded-pill p-2 pe-3 mb-2">
                        <img src="https://uxwing.com/wp-content/themes/uxwing/download/brands-and-social-media/grok-icon.svg"
                             alt="Grok"
                             width="32"
                             height="32"
                             class="grok-icon-${qId}">
                        <div class="form-check form-switch mb-0">
                            <input class="form-check-input"
                                   type="checkbox"
                                   role="switch"
                                   id="grokToggle${qId}"
                                   name="addQuestionDtos[${qId - 1}].AutoGrade"
                                   value="true">
                            <label class="form-check-label fw-semibold" for="grokToggle${qId}">
                                Grok Auto Grade
                            </label>
                        </div>
                    </div>
                `;

                // Add correct answer field
                container.innerHTML = `
                    <div class="mb-2">
                        <label class="form-label">Correct Answer *</label>
                        <input name="addQuestionDtos[${qId - 1}].CorrectAnswer" class="form-control" placeholder="Enter the correct answer" required />
                    </div>
                `;
                addBtn.style.display = 'none';
            } else { // Essay
                // Add Auto Grade checkbox to dedicated container
                autoGradeContainer.innerHTML = `
                   <div class="d-inline-flex align-items-center gap-2 border border-2 border-primary rounded-pill p-2 pe-3 mb-2">
                        <img src="https://uxwing.com/wp-content/themes/uxwing/download/brands-and-social-media/grok-icon.svg"
                             alt="Grok"
                             width="32"
                             height="32"
                             class="grok-icon-${qId}">
                        <div class="form-check form-switch mb-0">
                            <input class="form-check-input"
                                   type="checkbox"
                                   role="switch"
                                   id="grokToggle${qId}"
                                   name="addQuestionDtos[${qId - 1}].AutoGrade"
                                   value="true">
                            <label class="form-check-label fw-semibold" for="grokToggle${qId}">
                                Grok Auto Grade
                            </label>
                        </div>
                    </div>
                `;

                // Add model answer field
                container.innerHTML = `
                    <div class="mb-2">
                        <label class="form-label">Model Answer *</label>
                        <textarea name="addQuestionDtos[${qId - 1}].CorrectAnswer" class="form-control" rows="4" placeholder="Enter the model answer" required></textarea>
                    </div>
                `;
                addBtn.style.display = 'none';
            }
        }

        function removeQuestion(id) {
            const question = document.getElementById(`question-${id}`);
            if (question && confirm('Are you sure you want to remove this question?')) {
                question.remove();
                reindexQuestions();
            }
        }

        function reindexQuestions() {
            const questions = document.querySelectorAll('.question-block');
            questionCount = questions.length;

            questions.forEach((q, i) => {
                const newIndex = i + 1;
                q.id = `question-${newIndex}`;

                q.querySelector("h6").textContent = `Question ${newIndex}`;

                const removeBtn = q.querySelector('button.btn-outline-danger');
                removeBtn.setAttribute('onclick', `removeQuestion(${newIndex})`);

                // Update all input names
                const inputs = q.querySelectorAll('input, select, textarea');
                inputs.forEach(input => {
                    if (input.name && input.name.includes('addQuestionDtos')) {
                        input.name = input.name.replace(/addQuestionDtos\[\d+\]/g, `addQuestionDtos[${i}]`);
                    }
                });

                const autoGradeContainer = q.querySelector('.autograde-container');
                if (autoGradeContainer) autoGradeContainer.id = `autograde-container-${newIndex}`;

                const choicesContainer = q.querySelector('.choices-container');
                if (choicesContainer) choicesContainer.id = `choices-${newIndex}`;

                const choicesList = q.querySelector('.choices-container > div');
                if (choicesList) choicesList.id = `choices-list-${newIndex}`;

                const addChoiceBtn = q.querySelector('.btn-outline-primary');
                if (addChoiceBtn) {
                    addChoiceBtn.id = `addChoiceBtn-${newIndex}`;
                    addChoiceBtn.setAttribute('onclick', `addChoice(${newIndex})`);
                }

                const select = q.querySelector('select[name*="QuestionType"]');
                if (select) select.setAttribute('onchange', `toggleChoices(this, ${newIndex})`);
            });
        }

        // Add a question automatically when page loads
        document.addEventListener('DOMContentLoaded', function() {
            addQuestion();
        });
    </script>
}

<style>
    .form-label {
        color: #333;
    }

    .fw-bold {
        font-weight: 600 !important;
    }

    .form-check-input:checked {
        background-color: #0d6efd;
        border-color: #0d6efd;
    }

    .form-check-label {
        color: #444;
    }

    .btn-primary {
        background-color: #0d6efd;
        border: none;
    }

        .btn-primary:hover {
            background-color: #0b5ed7;
        }

    .btn-outline-primary:hover {
        background-color: #0d6efd;
        color: white;
    }

    .card, .form-control, .form-select {
        border-radius: 0.5rem;
    }
</style>