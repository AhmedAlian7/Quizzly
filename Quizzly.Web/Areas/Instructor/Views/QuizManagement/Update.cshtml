@using Quizzly.Business.ViewModels.Quiz
@model QuizDetailsDto
@{
    ViewData["Title"] = "Update Quiz";
}

<div class="container mt-4 mb-5">
    <h2 class="mb-4 fw-bold text-primary">Update Quiz</h2>

    <form asp-action="Update" method="post" enctype="multipart/form-data" class="bg-white p-4 rounded shadow-sm">
        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="Id" />

        <!-- Basic Quiz Information -->
        <div class="row mb-4">
            <div class="col-md-8">
                <div class="form-group mb-3">
                    <label asp-for="Title" class="form-label fw-semibold">Quiz Title *</label>
                    <input asp-for="Title" class="form-control" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Description" class="form-label fw-semibold">Description</label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>
            </div>

            <div class="col-md-4">
                <div class="form-group mb-3">
                    <label asp-for="CategoryId" class="form-label fw-semibold">Category *</label>
                    <select asp-for="CategoryId" asp-items="Model.Categories" class="form-select">
                        <option value="">Select Category</option>
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger small"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="TimeLimit" class="form-label fw-semibold">Time Limit (minutes) *</label>
                    <input asp-for="TimeLimit" type="number" class="form-control" min="1" max="180" />
                    <span asp-validation-for="TimeLimit" class="text-danger small"></span>
                </div>
            </div>
        </div>

        <!-- Quiz Settings -->
        <div class="row mb-4">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header bg-light">
                        <h6 class="mb-0">Quiz Behavior</h6>
                    </div>
                    <div class="card-body">
                        <div class="form-check form-switch mb-3">
                            <input type="hidden" asp-for="ShuffleQuestions" value="false" />
                            <input asp-for="ShuffleQuestions" class="form-check-input" value="true" />
                            <label asp-for="ShuffleQuestions" class="form-check-label">Shuffle Questions</label>
                        </div>

                        <div class="form-check form-switch mb-3">
                            <input type="hidden" asp-for="ShuffleChoices" value="false" />
                            <input asp-for="ShuffleChoices" class="form-check-input" value="true" />
                            <label asp-for="ShuffleChoices" class="form-check-label">Shuffle Choices</label>
                        </div>

                        <div class="form-check form-switch mb-3">
                            <input type="hidden" asp-for="AllowMultipleAttempts" value="false" />
                            <input asp-for="AllowMultipleAttempts" class="form-check-input" value="true" id="AllowMultipleAttempts" />
                            <label asp-for="AllowMultipleAttempts" class="form-check-label">Allow Multiple Attempts</label>
                        </div>

                        <div class="form-group mb-3" id="maxAttemptsGroup" style="display: none;">
                            <label asp-for="MaxAttempts" class="form-label fw-semibold">Max Attempts</label>
                            <input asp-for="MaxAttempts" type="number" class="form-control" min="1" max="5" />
                            <span asp-validation-for="MaxAttempts" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card">
                    <div class="card-header bg-light">
                        <h6 class="mb-0">Grading & Display</h6>
                    </div>
                    <div class="card-body">
                        <div class="form-check form-switch mb-3">
                            <input type="hidden" asp-for="IsAutoGraded" value="false" />
                            <input asp-for="IsAutoGraded" class="form-check-input" value="true" />
                            <label asp-for="IsAutoGraded" class="form-check-label">Auto Grade Quiz</label>
                        </div>

                        <div class="form-check form-switch mb-3">
                            <input type="hidden" asp-for="ShowCorrectAnswers" value="false" />
                            <input asp-for="ShowCorrectAnswers" class="form-check-input" value="true" />
                            <label asp-for="ShowCorrectAnswers" class="form-check-label">Show Correct Answers</label>
                        </div>

                        <div class="form-check form-switch mb-3">
                            <input type="hidden" asp-for="ShowScoreImmediatlely" value="false" />
                            <input asp-for="ShowScoreImmediatlely" class="form-check-input" value="true" />
                            <label asp-for="ShowScoreImmediatlely" class="form-check-label">Show Score Immediately</label>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="PassingScore" class="form-label fw-semibold">Passing Score (%)</label>
                            <input asp-for="PassingScore" type="number" class="form-control" min="0" max="100" step="0.1" />
                            <span asp-validation-for="PassingScore" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Date & Time Settings -->
        <div class="row mb-4">
            <div class="col-md-6">
                <div class="form-group mb-3">
                    <label asp-for="StartAt" class="form-label fw-semibold">Start Date & Time</label>
                    <input asp-for="StartAt" type="datetime-local" class="form-control"
                           value="@Model.StartAt?.ToString("yyyy-MM-ddTHH:mm")" />
                    <span asp-validation-for="StartAt" class="text-danger small"></span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group mb-3">
                    <label asp-for="EndAt" class="form-label fw-semibold">End Date & Time</label>
                    <input asp-for="EndAt" type="datetime-local" class="form-control"
                           value="@Model.EndAt?.ToString("yyyy-MM-ddTHH:mm")" />
                    <span asp-validation-for="EndAt" class="text-danger small"></span>
                </div>
            </div>
        </div>

        <!-- Questions Section -->
        <div class="card mb-4">
            <div class="card-header bg-light d-flex justify-content-between align-items-center">
                <h6 class="mb-0">Questions</h6>
                <button type="button" class="btn btn-sm btn-success" onclick="addQuestion()">
                    <i class="fas fa-plus"></i> Add Question
                </button>
            </div>
            <div class="card-body" id="questions-container">
                @for (int i = 0; i < Model.Questions.Count; i++)
                {
                    var question = Model.Questions[i];
                    <div class="question-card card mb-3" data-index="@i">
                        <div class="card-header bg-light d-flex justify-content-between align-items-center">
                            <h6 class="mb-0">Question @(i + 1)</h6>
                            <button type="button" class="btn btn-sm btn-danger" onclick="removeQuestion(@i)">
                                <i class="fas fa-trash"></i> Remove
                            </button>
                        </div>
                        <div class="card-body">
                            <div class="row mb-3">
                                <div class="col-md-8">
                                    <label class="form-label fw-semibold">Question Text *</label>
                                    <textarea name="Questions[@i].Text" class="form-control" rows="2">@question.Text</textarea>
                                    <span class="text-danger small" data-valmsg-for="Questions[@i].Text" data-valmsg-replace="true"></span>
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label fw-semibold">Points *</label>
                                    <input name="Questions[@i].Points" type="number" class="form-control" min="0.5" step="0.5" value="@question.Points" />
                                    <span class="text-danger small" data-valmsg-for="Questions[@i].Points" data-valmsg-replace="true"></span>
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label fw-semibold">Type *</label>
                                    <select name="Questions[@i].QuestionType" class="form-select question-type" onchange="toggleChoices(@i)">
                                        <option value="0" selected="@(question.QuestionType == Quizzly.DataAccess.Enums.QuestionType.MCQ)">Multiple Choice</option>
                                        <option value="1" selected="@(question.QuestionType == Quizzly.DataAccess.Enums.QuestionType.TrueFalse)">True/False</option>
                                        <option value="2" selected="@(question.QuestionType == Quizzly.DataAccess.Enums.QuestionType.ShortAnswer)">Short Answer</option>
                                        <option value="3" selected="@(question.QuestionType == Quizzly.DataAccess.Enums.QuestionType.Essay)">Essay</option>
                                    </select>
                                    <span class="text-danger small" data-valmsg-for="Questions[@i].QuestionType" data-valmsg-replace="true"></span>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold">Question Image</label>
                                <input name="Questions[@i].ImageFile" type="file" class="form-control" accept="image/*" />
                                @if (!string.IsNullOrEmpty(question.ImageUrl))
                                {
                                    <div class="mt-2">
                                        <img src="@question.ImageUrl" alt="Question Image" style="max-height: 150px;" class="img-thumbnail" />
                                        <input type="hidden" name="Questions[@i].ImageUrl" value="@question.ImageUrl" />
                                    </div>
                                }
                            </div>

                            <!-- Choices for MCQ/TrueFalse -->
                            <div class="choices-container" id="choices-@i" style="@(question.QuestionType == Quizzly.DataAccess.Enums.QuestionType.ShortAnswer || question.QuestionType == Quizzly.DataAccess.Enums.QuestionType.Essay ? "display:none;" : "")">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <label class="form-label fw-semibold">Choices</label>
                                    <button type="button" class="btn btn-sm btn-outline-primary" onclick="addChoice(@i)">
                                        <i class="fas fa-plus"></i> Add Choice
                                    </button>
                                </div>

                                <div class="choices-list" id="choices-list-@i">
                                    @for (int j = 0; j < question.Choices.Count; j++)
                                    {
                                        var choice = question.Choices[j];
                                        <div class="choice-item input-group mb-2">
                                            <div class="input-group-text">
                                                <input type="hidden" name="Questions[@i].Choices[@j].IsCorrect" value="false" />
                                                <input name="Questions[@i].Choices[@j].IsCorrect" value="true"
                                                       type="checkbox" class="form-check-input"
                                                       @(choice.IsCorrect ? "checked" : "") />
                                            </div>
                                            <input name="Questions[@i].Choices[@j].Text" type="text"
                                                   class="form-control" placeholder="Choice text"
                                                   value="@choice.Text" />
                                            <button type="button" class="btn btn-outline-danger" onclick="removeChoice(@i, @j)">
                                                <i class="fas fa-times"></i>
                                            </button>
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- Correct Answer for Short Answer -->
                            <div class="correct-answer-container" id="correct-answer-@i" style="@(question.QuestionType == Quizzly.DataAccess.Enums.QuestionType.ShortAnswer ? "" : "display:none;")">
                                <label class="form-label fw-semibold">Correct Answer</label>
                                <input type="text" name="Questions[@i].CorrectAnswer" class="form-control"
                                       value="@(question.Choices.FirstOrDefault()?.Text)" placeholder="Enter the correct answer" />
                            </div>

                            <!-- Essay instructions -->
                            <div class="essay-container" id="essay-@i" style="@(question.QuestionType == Quizzly.DataAccess.Enums.QuestionType.Essay ? "" : "display:none;")">
                                <div class="alert alert-info">
                                    <small><strong>Essay Question:</strong> Students will write their answer in a text area. Manual grading required.</small>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Submit Buttons -->
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Update Quiz</button>
            <a href="@Url.Action("Index")" class="btn btn-secondary">Cancel</a>
            @if (!Model.IsPublished)
            {
                <button type="submit" formaction="@Url.Action("Publish", new { id = Model.Id })"
                        class="btn btn-success ms-auto">
                    Publish Quiz
                </button>
            }
        </div>
    </form>
</div>

@section Scripts {
    <script>
        // Toggle Max Attempts field
        document.getElementById('AllowMultipleAttempts').addEventListener('change', function() {
            document.getElementById('maxAttemptsGroup').style.display = this.checked ? 'block' : 'none';
        });

        // Initialize Max Attempts visibility
        document.addEventListener('DOMContentLoaded', function() {
            document.getElementById('maxAttemptsGroup').style.display =
                document.getElementById('AllowMultipleAttempts').checked ? 'block' : 'none';
        });

        let questionCount = @Model.Questions.Count;

        function addQuestion() {
            const container = document.getElementById('questions-container');
            const index = questionCount++;

            const questionHtml = `
                <div class="question-card card mb-3" data-index="${index}">
                    <div class="card-header bg-light d-flex justify-content-between align-items-center">
                        <h6 class="mb-0">Question ${index + 1}</h6>
                        <button type="button" class="btn btn-sm btn-danger" onclick="removeQuestion(${index})">
                            <i class="fas fa-trash"></i> Remove
                        </button>
                    </div>
                    <div class="card-body">
                        <div class="row mb-3">
                            <div class="col-md-8">
                                <label class="form-label fw-semibold">Question Text *</label>
                                <textarea name="Questions[${index}].Text" class="form-control" rows="2" required></textarea>
                            </div>
                            <div class="col-md-2">
                                <label class="form-label fw-semibold">Points *</label>
                                <input name="Questions[${index}].Points" type="number" class="form-control" min="0.5" step="0.5" value="1" required />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label fw-semibold">Type *</label>
                                <select name="Questions[${index}].QuestionType" class="form-select question-type" onchange="toggleChoices(${index})" required>
                                    <option value="0">Multiple Choice</option>
                                    <option value="1">True/False</option>
                                    <option value="2">Short Answer</option>
                                    <option value="3">Essay</option>
                                </select>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Question Image</label>
                            <input name="Questions[${index}].ImageFile" type="file" class="form-control" accept="image/*" />
                        </div>

                        <div class="choices-container" id="choices-${index}">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <label class="form-label fw-semibold">Choices</label>
                                <button type="button" class="btn btn-sm btn-outline-primary" onclick="addChoice(${index})">
                                    <i class="fas fa-plus"></i> Add Choice
                                </button>
                            </div>
                            <div class="choices-list" id="choices-list-${index}"></div>
                        </div>

                        <div class="correct-answer-container" id="correct-answer-${index}" style="display: none;">
                            <label class="form-label fw-semibold">Correct Answer</label>
                            <input type="text" name="Questions[${index}].CorrectAnswer" class="form-control" placeholder="Enter the correct answer" />
                        </div>

                        <div class="essay-container" id="essay-${index}" style="display: none;">
                            <div class="alert alert-info">
                                <small><strong>Essay Question:</strong> Students will write their answer in a text area. Manual grading required.</small>
                            </div>
                        </div>
                    </div>
                </div>
            `;

            container.insertAdjacentHTML('beforeend', questionHtml);
        }

        function removeQuestion(index) {
            const questionCard = document.querySelector(`.question-card[data-index="${index}"]`);
            if (questionCard && confirm('Are you sure you want to remove this question?')) {
                questionCard.remove();
                reindexQuestions();
            }
        }

        function reindexQuestions() {
            const questions = document.querySelectorAll('.question-card');
            questionCount = questions.length;

            questions.forEach((question, newIndex) => {
                question.setAttribute('data-index', newIndex);
                question.querySelector('.card-header h6').textContent = `Question ${newIndex + 1}`;

                // Update all names and IDs within this question
                question.querySelectorAll('[name]').forEach(element => {
                    const name = element.getAttribute('name');
                    const newName = name.replace(/Questions\[\d+\]/, `Questions[${newIndex}]`);
                    element.setAttribute('name', newName);
                });

                question.querySelectorAll('[id]').forEach(element => {
                    const id = element.getAttribute('id');
                    if (id.includes('choices-')) {
                        element.setAttribute('id', `choices-${newIndex}`);
                    } else if (id.includes('choices-list-')) {
                        element.setAttribute('id', `choices-list-${newIndex}`);
                    } else if (id.includes('correct-answer-')) {
                        element.setAttribute('id', `correct-answer-${newIndex}`);
                    } else if (id.includes('essay-')) {
                        element.setAttribute('id', `essay-${newIndex}`);
                    }
                });

                // Update event handlers
                const typeSelect = question.querySelector('.question-type');
                typeSelect.setAttribute('onchange', `toggleChoices(${newIndex})`);

                const addChoiceBtn = question.querySelector('button[onclick*="addChoice"]');
                if (addChoiceBtn) {
                    addChoiceBtn.setAttribute('onclick', `addChoice(${newIndex})`);
                }

                // Reindex choices
                const choices = question.querySelectorAll('.choice-item');
                choices.forEach((choice, choiceIndex) => {
                    choice.querySelectorAll('[name]').forEach(element => {
                        const name = element.getAttribute('name');
                        const newName = name.replace(/Choices\[\d+\]/, `Choices[${choiceIndex}]`);
                        element.setAttribute('name', newName);
                    });

                    const removeBtn = choice.querySelector('button[onclick*="removeChoice"]');
                    if (removeBtn) {
                        removeBtn.setAttribute('onclick', `removeChoice(${newIndex}, ${choiceIndex})`);
                    }
                });
            });
        }

        function toggleChoices(questionIndex) {
            const typeSelect = document.querySelector(`[name="Questions[${questionIndex}].QuestionType"]`);
            const choicesContainer = document.getElementById(`choices-${questionIndex}`);
            const correctAnswerContainer = document.getElementById(`correct-answer-${questionIndex}`);
            const essayContainer = document.getElementById(`essay-${questionIndex}`);

            // Hide all containers first
            choicesContainer.style.display = 'none';
            correctAnswerContainer.style.display = 'none';
            essayContainer.style.display = 'none';

            // Show appropriate container based on question type
            const questionType = parseInt(typeSelect.value);
            switch(questionType) {
                case 0: // MCQ
                case 1: // True/False
                    choicesContainer.style.display = 'block';
                    if (questionType === 1) { // True/False
                        addTrueFalseChoices(questionIndex);
                    }
                    break;
                case 2: // Short Answer
                    correctAnswerContainer.style.display = 'block';
                    break;
                case 3: // Essay
                    essayContainer.style.display = 'block';
                    break;
            }
        }

        function addTrueFalseChoices(questionIndex) {
            const choicesList = document.getElementById(`choices-list-${questionIndex}`);
            if (choicesList.children.length === 0) {
                const trueFalseChoices = [
                    { text: 'True', isCorrect: true },
                    { text: 'False', isCorrect: false }
                ];

                trueFalseChoices.forEach((choice, index) => {
                    const choiceHtml = `
                        <div class="choice-item input-group mb-2">
                            <div class="input-group-text">
                                <input type="hidden" name="Questions[${questionIndex}].Choices[${index}].IsCorrect" value="false" />
                                <input name="Questions[${questionIndex}].Choices[${index}].IsCorrect" value="true"
                                       type="checkbox" class="form-check-input" ${choice.isCorrect ? 'checked' : ''} />
                            </div>
                            <input name="Questions[${questionIndex}].Choices[${index}].Text" type="text"
                                   class="form-control" value="${choice.text}" readonly />
                            <button type="button" class="btn btn-outline-danger" onclick="removeChoice(${questionIndex}, ${index})">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>
                    `;
                    choicesList.insertAdjacentHTML('beforeend', choiceHtml);
                });
            }
        }

        function addChoice(questionIndex) {
            const choicesList = document.getElementById(`choices-list-${questionIndex}`);
            const choiceIndex = choicesList.children.length;

            const choiceHtml = `
                <div class="choice-item input-group mb-2">
                    <div class="input-group-text">
                        <input type="hidden" name="Questions[${questionIndex}].Choices[${choiceIndex}].IsCorrect" value="false" />
                        <input name="Questions[${questionIndex}].Choices[${choiceIndex}].IsCorrect" value="true"
                               type="checkbox" class="form-check-input" />
                    </div>
                    <input name="Questions[${questionIndex}].Choices[${choiceIndex}].Text" type="text"
                           class="form-control" placeholder="Choice text" />
                    <button type="button" class="btn btn-outline-danger" onclick="removeChoice(${questionIndex}, ${choiceIndex})">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
            `;

            choicesList.insertAdjacentHTML('beforeend', choiceHtml);
        }

        function removeChoice(questionIndex, choiceIndex) {
            const choiceItem = document.querySelector(`[name="Questions[${questionIndex}].Choices[${choiceIndex}].Text"]`)?.closest('.choice-item');
            if (choiceItem) {
                choiceItem.remove();
                reindexChoices(questionIndex);
            }
        }

        function reindexChoices(questionIndex) {
            const choicesList = document.getElementById(`choices-list-${questionIndex}`);
            const choices = choicesList.querySelectorAll('.choice-item');

            choices.forEach((choice, newIndex) => {
                choice.querySelectorAll('[name]').forEach(element => {
                    const name = element.getAttribute('name');
                    const newName = name.replace(/Choices\[\d+\]/, `Choices[${newIndex}]`);
                    element.setAttribute('name', newName);
                });

                const removeBtn = choice.querySelector('button');
                removeBtn.setAttribute('onclick', `removeChoice(${questionIndex}, ${newIndex})`);
            });
        }

        // Initialize question types on page load
        document.addEventListener('DOMContentLoaded', function() {
            document.querySelectorAll('.question-type').forEach((select, index) => {
                toggleChoices(index);
            });
        });
    </script>
}