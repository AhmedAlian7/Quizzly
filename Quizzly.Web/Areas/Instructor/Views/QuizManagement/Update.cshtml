@using Quizzly.Business.ViewModels.Quiz
@model QuizDetailsDto

@{
    ViewData["Title"] = "Update Quiz";
}

<div class="container mt-4 mb-5">
    <h2 class="mb-4 fw-bold text-primary">Update Quiz</h2>

    <form asp-action="Update" method="post" enctype="multipart/form-data" class="bg-white p-4 rounded shadow-sm">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <!-- Published Status -->
        <div class="alert alert-light border d-flex justify-content-between align-items-center mb-4">
            <div>
                <strong>Quiz Status:</strong>
                <span class="badge bg-success ms-2" id="publishedBadge" style="display: @(Model.IsPublished ? "inline-block" : "none")">Published</span>
                <span class="badge bg-secondary ms-2" id="draftBadge" style="display: @(Model.IsPublished ? "none" : "inline-block")">Draft</span>
            </div>
            <div class="form-check form-switch mb-0">
                <input asp-for="IsPublished" class="form-check-input" style="width: 3rem; height: 1.5rem; cursor: pointer;" />
                <label asp-for="IsPublished" class="form-check-label fw-semibold">Publish Quiz</label>
            </div>
        </div>

        <!-- Basic Info -->
        <div class="row mb-3">
            <div class="col-md-8">
                <label asp-for="Title" class="form-label fw-semibold">Quiz Title *</label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger small"></span>

                <label asp-for="Description" class="form-label fw-semibold mt-3">Description</label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            </div>

            <div class="col-md-4">
                <label asp-for="CategoryId" class="form-label fw-semibold">Category</label>
                <select asp-for="CategoryId" asp-items="Model.Categories" class="form-select">
                    <option value="">-- Select Category --</option>
                </select>

                <label asp-for="TimeLimit" class="form-label fw-semibold mt-3">Time Limit (minutes)</label>
                <input asp-for="TimeLimit" type="number" class="form-control" min="1" />
            </div>
        </div>

        <!-- Quiz Settings -->
        <div class="row mb-4">
            <div class="col-md-6">
                <div class="form-check form-switch">
                    <input asp-for="ShuffleQuestions" class="form-check-input" />
                    <label asp-for="ShuffleQuestions" class="form-check-label">Shuffle Questions</label>
                </div>

                <div class="form-check form-switch">
                    <input asp-for="ShuffleChoices" class="form-check-input" />
                    <label asp-for="ShuffleChoices" class="form-check-label">Shuffle Choices</label>
                </div>

                <div class="form-check form-switch">
                    <input asp-for="AllowMultipleAttempts" class="form-check-input" id="allowMultipleAttemptsToggle" />
                    <label asp-for="AllowMultipleAttempts" class="form-check-label">Allow Multiple Attempts</label>
                </div>

                <!-- Max Attempts Field (shows when AllowMultipleAttempts is true) -->
                <div class="mt-3" id="maxAttemptsContainer" style="display: @(Model.AllowMultipleAttempts ? "block" : "none");">
                    <label asp-for="MaxAttempts" class="form-label fw-semibold">Max Attempts</label>
                    <input asp-for="MaxAttempts" type="number" class="form-control" min="1" max="10" value="@Model.MaxAttempts" placeholder="Leave empty for unlimited" />
                    <small class="text-muted d-block mt-1">Leave empty for unlimited attempts</small>
                </div>
            </div>

            <div class="col-md-6">
                <div class="form-check form-switch">
                    <input asp-for="ShowCorrectAnswers" class="form-check-input" />
                    <label asp-for="ShowCorrectAnswers" class="form-check-label">Show Correct Answers</label>
                </div>

                <div class="form-check form-switch">
                    <input asp-for="ShowScoreImmediatlely" class="form-check-input" />
                    <label asp-for="ShowScoreImmediatlely" class="form-check-label">Show Score Immediately</label>
                </div>
            </div>
        </div>

        <!-- Questions -->
        <div class="card mb-4">
            <div class="card-header bg-light d-flex justify-content-between align-items-center">
                <h6 class="mb-0">Questions</h6>
                <button type="button" class="btn btn-sm btn-success" onclick="addQuestion()">
                    <i class="fas fa-plus"></i> Add Question
                </button>
            </div>

            <div class="card-body" id="questions-container">
                @for (int i = 0; i < Model.Questions.Count; i++)
                {
                    var question = Model.Questions[i];
                    <div class="card mb-3 question-card" data-index="@i">
                        <div class="card-header d-flex justify-content-between align-items-center bg-light">
                            <h6 class="mb-0">Question @(i + 1)</h6>
                            <button type="button" class="btn btn-sm btn-danger" onclick="removeQuestion(@i)">
                                <i class="fas fa-trash"></i> Remove
                            </button>
                        </div>

                        <div class="card-body">
                            <div class="row mb-3">
                                <div class="col-md-8">
                                    <label class="form-label fw-semibold">Question Text *</label>
                                    <textarea name="Questions[@i].Text" class="form-control" rows="2">@question.Text</textarea>
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label fw-semibold">Points *</label>
                                    <input name="Questions[@i].Points" type="number" class="form-control" value="@question.Points" min="0.5" step="0.5" />
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label fw-semibold">Type *</label>
                                    <select name="Questions[@i].QuestionType" class="form-select question-type" onchange="toggleChoices(@i)">
                                        <option value="0" selected="@(question.QuestionType == Quizzly.DataAccess.Enums.QuestionType.MCQ)">Multiple Choice</option>
                                        <option value="1" selected="@(question.QuestionType == Quizzly.DataAccess.Enums.QuestionType.TrueFalse)">True/False</option>
                                        <option value="2" selected="@(question.QuestionType == Quizzly.DataAccess.Enums.QuestionType.ShortAnswer)">Short Answer</option>
                                        <option value="3" selected="@(question.QuestionType == Quizzly.DataAccess.Enums.QuestionType.Essay)">Essay</option>
                                    </select>
                                </div>
                            </div>

                            <!-- Required & AutoGrade -->
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <div class="form-check form-switch">
                                        <input name="Questions[@i].IsRequired" type="checkbox" class="form-check-input" value="true" @(question.IsRequired ? "checked" : "") />
                                        <label class="form-check-label">Required Question</label>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-check form-switch auto-grade-toggle" id="auto-grade-@i"
                                         style="@(question.QuestionType == Quizzly.DataAccess.Enums.QuestionType.ShortAnswer || question.QuestionType == Quizzly.DataAccess.Enums.QuestionType.Essay ? "" : "display:none;")">
                                        <input name="Questions[@i].AutoGrade" type="checkbox" class="form-check-input" value="true" @(question.AutoGrade ? "checked" : "") />
                                        <label class="form-check-label">Auto Grade</label>
                                    </div>
                                </div>
                            </div>

                            <!-- Image -->
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Question Image</label>
                                <input name="Questions[@i].ImageFile" type="file" class="form-control" accept="image/*" />
                                @if (!string.IsNullOrEmpty(question.ImageUrl))
                                {
                                    <div class="mt-2">
                                        <img src="@question.ImageUrl" alt="Question Image" class="img-thumbnail" style="max-height: 150px;" />
                                        <input type="hidden" name="Questions[@i].ImageUrl" value="@question.ImageUrl" />
                                    </div>
                                }
                            </div>

                            <!-- Choices -->
                            <div class="choices-container" id="choices-@i" style="@(question.QuestionType == Quizzly.DataAccess.Enums.QuestionType.ShortAnswer || question.QuestionType == Quizzly.DataAccess.Enums.QuestionType.Essay ? "display:none;" : "")">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <label class="form-label fw-semibold">Choices</label>
                                    <button type="button" class="btn btn-sm btn-outline-primary" onclick="addChoice(@i)">
                                        <i class="fas fa-plus"></i> Add Choice
                                    </button>
                                </div>

                                <div class="choices-list" id="choices-list-@i">
                                    @for (int j = 0; j < question.Choices.Count; j++)
                                    {
                                        var choice = question.Choices[j];
                                        <div class="choice-item input-group mb-2">
                                            <div class="input-group-text">
                                                <input name="Questions[@i].Choices[@j].IsCorrect" value="true"
                                                       type="checkbox" class="form-check-input"
                                                       @(choice.IsCorrect ? "checked" : "") />
                                            </div>
                                            <input name="Questions[@i].Choices[@j].Text" type="text"
                                                   class="form-control" placeholder="Choice text"
                                                   value="@choice.Text" />
                                            <button type="button" class="btn btn-outline-danger" onclick="removeChoice(@i, @j)">
                                                <i class="fas fa-times"></i>
                                            </button>
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- Short Answer -->
                            <div class="correct-answer-container" id="correct-answer-@i" style="@(question.QuestionType == Quizzly.DataAccess.Enums.QuestionType.ShortAnswer ? "" : "display:none;")">
                                <label class="form-label fw-semibold">Correct Answer</label>
                                <input type="text" name="Questions[@i].Choices[0].Text" class="form-control"
                                       value="@(question.Choices.FirstOrDefault()?.Text)" placeholder="Enter the correct answer" />
                            </div>

                            <!-- Essay -->
                            <div class="essay-container" id="essay-@i" style="@(question.QuestionType == Quizzly.DataAccess.Enums.QuestionType.Essay ? "" : "display:none;")">
                                <label class="form-label fw-semibold">Model Answer (Optional)</label>
                                <textarea name="Questions[@i].Choices[0].Text" class="form-control" rows="4"
                                      placeholder="Enter a sample/model answer">@question.Choices.FirstOrDefault()?.Text</textarea>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Update Quiz</button>
            <a href="@Url.Action("Index")" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            // Toggle badge display for IsPublished
            const isPublishedCheckbox = document.querySelector('input[name="IsPublished"]');
            const publishedBadge = document.getElementById('publishedBadge');
            const draftBadge = document.getElementById('draftBadge');

            if (isPublishedCheckbox) {
                isPublishedCheckbox.addEventListener('change', function() {
                    if (this.checked) {
                        publishedBadge.style.display = 'inline-block';
                        draftBadge.style.display = 'none';
                    } else {
                        publishedBadge.style.display = 'none';
                        draftBadge.style.display = 'inline-block';
                    }
                });
            }

            // Toggle MaxAttempts field visibility
            const allowMultipleAttemptsToggle = document.getElementById('allowMultipleAttemptsToggle');
            const maxAttemptsContainer = document.getElementById('maxAttemptsContainer');

            if (allowMultipleAttemptsToggle && maxAttemptsContainer) {
                allowMultipleAttemptsToggle.addEventListener('change', function() {
                    if (this.checked) {
                        maxAttemptsContainer.style.display = 'block';
                    } else {
                        maxAttemptsContainer.style.display = 'none';
                    }
                });
            }

            // initial count based on server model
            let questionCount = @Model.Questions.Count;

            // expose functions globally for inline onclicks
            window.addQuestion = addQuestion;
            window.removeQuestion = removeQuestion;
            window.addChoice = addChoice;
            window.removeChoice = removeChoice;
            window.toggleChoices = toggleChoices;
            window.reindexQuestions = reindexQuestions;
            window.reindexChoices = reindexChoices;
            window.addTrueFalseChoices = addTrueFalseChoices;

            // normalize existing DOM
            reindexQuestions();

            // ensure we reindex before submit so names are stable
            const form = document.querySelector("form");
            if (form) {
                form.addEventListener("submit", () => reindexQuestions());
            }

            // ---------- functions ----------

            function addQuestion() {
                const container = document.getElementById("questions-container");
                if (!container) return;

                const index = questionCount++;

                const html = `
                <div class="card mb-3 question-card" data-index="${index}">
                    <div class="card-header d-flex justify-content-between align-items-center bg-light">
                        <h6 class="mb-0">Question ${index + 1}</h6>
                        <button type="button" class="btn btn-sm btn-danger" onclick="removeQuestion(${index})">
                            <i class="fas fa-trash"></i> Remove
                        </button>
                    </div>

                    <div class="card-body">
                        <div class="row mb-3">
                            <div class="col-md-8">
                                <label class="form-label fw-semibold">Question Text *</label>
                                <textarea name="Questions[${index}].Text" class="form-control" rows="2"></textarea>
                            </div>
                            <div class="col-md-2">
                                <label class="form-label fw-semibold">Points *</label>
                                <input name="Questions[${index}].Points" type="number" class="form-control" value="1" min="0.5" step="0.5" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label fw-semibold">Type *</label>
                                <select name="Questions[${index}].QuestionType" class="form-select question-type" onchange="toggleChoices(${index})">
                                    <option value="0">Multiple Choice</option>
                                    <option value="1">True/False</option>
                                    <option value="2">Short Answer</option>
                                    <option value="3">Essay</option>
                                </select>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <div class="form-check form-switch">
                                    <input name="Questions[${index}].IsRequired" type="checkbox" class="form-check-input" value="true" />
                                    <label class="form-check-label">Required Question</label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-check form-switch auto-grade-toggle" id="auto-grade-${index}" style="display:none;">
                                    <input name="Questions[${index}].AutoGrade" type="checkbox" class="form-check-input" value="true" />
                                    <label class="form-check-label">Auto Grade</label>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Question Image</label>
                            <input name="Questions[${index}].ImageFile" type="file" class="form-control" accept="image/*" />
                        </div>

                        <div class="choices-container" id="choices-${index}">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <label class="form-label fw-semibold">Choices</label>
                                <button type="button" class="btn btn-sm btn-outline-primary" onclick="addChoice(${index})">
                                    <i class="fas fa-plus"></i> Add Choice
                                </button>
                            </div>
                            <div class="choices-list" id="choices-list-${index}"></div>
                        </div>

                        <div class="correct-answer-container" id="correct-answer-${index}" style="display:none;">
                            <label class="form-label fw-semibold">Correct Answer</label>
                            <input type="text" name="Questions[${index}].Choices[0].Text" class="form-control" placeholder="Enter the correct answer" />
                        </div>

                        <div class="essay-container" id="essay-${index}" style="display:none;">
                            <label class="form-label fw-semibold">Model Answer (Optional)</label>
                            <textarea name="Questions[${index}].Choices[0].Text" class="form-control" rows="4" placeholder="Enter a sample/model answer"></textarea>
                        </div>
                    </div>
                </div>`;

                container.insertAdjacentHTML("beforeend", html);
                reindexQuestions();
            }

            function removeQuestion(index) {
                const card = document.querySelector(`.question-card[data-index="${index}"]`);
                if (!card) {
                    const all = Array.from(document.querySelectorAll('.question-card'));
                    if (all[index]) {
                        all[index].remove();
                        reindexQuestions();
                    }
                    return;
                }

                if (!confirm("Are you sure you want to remove this question?")) return;
                card.remove();
                reindexQuestions();
            }

            function addChoice(questionIndex) {
                const card = document.querySelector(`.question-card[data-index="${questionIndex}"]`);
                const list = (card && card.querySelector('.choices-list')) || document.getElementById(`choices-list-${questionIndex}`);
                if (!list) return;

                const choiceIndex = list.children.length;

                const html = `
                    <div class="choice-item input-group mb-2">
                        <div class="input-group-text">
                            <input name="Questions[${questionIndex}].Choices[${choiceIndex}].IsCorrect" type="checkbox" class="form-check-input" />
                        </div>
                        <input name="Questions[${questionIndex}].Choices[${choiceIndex}].Text" type="text" class="form-control" placeholder="Choice text" />
                        <button type="button" class="btn btn-outline-danger" onclick="removeChoice(${questionIndex}, ${choiceIndex})">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>`;

                list.insertAdjacentHTML('beforeend', html);
                reindexChoices(questionIndex);
            }

            function removeChoice(qIndex, cIndex) {
                const selector = `[name="Questions[${qIndex}].Choices[${cIndex}].Text"]`;
                const el = document.querySelector(selector);
                if (el) {
                    const group = el.closest('.choice-item');
                    if (group) group.remove();
                    reindexChoices(qIndex);
                    return;
                }

                const list = document.getElementById(`choices-list-${qIndex}`);
                if (list && list.children[cIndex]) {
                    list.children[cIndex].remove();
                    reindexChoices(qIndex);
                }
            }

            function reindexQuestions() {
                const cards = Array.from(document.querySelectorAll('.question-card'));
                questionCount = cards.length;

                cards.forEach((card, qIndex) => {
                    card.setAttribute('data-index', qIndex);

                    // update header title
                    const heading = card.querySelector('.card-header h6') || card.querySelector('.card-header .mb-0');
                    if (heading) heading.textContent = `Question ${qIndex + 1}`;

                    // update all names for this card
                    card.querySelectorAll('[name]').forEach(el => {
                        el.name = el.name.replace(/Questions\[\d+\]/g, `Questions[${qIndex}]`);
                    });

                    // update containers IDs
                    const choicesContainer = card.querySelector('.choices-container');
                    if (choicesContainer) choicesContainer.id = `choices-${qIndex}`;
                    const choicesList = card.querySelector('.choices-list');
                    if (choicesList) choicesList.id = `choices-list-${qIndex}`;
                    const correct = card.querySelector('.correct-answer-container');
                    if (correct) correct.id = `correct-answer-${qIndex}`;
                    const essay = card.querySelector('.essay-container');
                    if (essay) essay.id = `essay-${qIndex}`;
                    const autoGrade = card.querySelector('.auto-grade-toggle');
                    if (autoGrade) autoGrade.id = `auto-grade-${qIndex}`;

                    // inline onclicks
                    const rmBtn = card.querySelector('.card-header .btn-danger');
                    if (rmBtn) rmBtn.setAttribute('onclick', `removeQuestion(${qIndex})`);
                    const addChoiceBtn = card.querySelector('button[onclick*="addChoice"]');
                    if (addChoiceBtn) addChoiceBtn.setAttribute('onclick', `addChoice(${qIndex})`);
                    const typeSelect = card.querySelector('.question-type, select[name*="QuestionType"]');
                    if (typeSelect) typeSelect.setAttribute('onchange', `toggleChoices(${qIndex})`);

                    // reindex choices inside
                    reindexChoices(qIndex);
                });
            }

            function reindexChoices(questionIndex) {
                const choicesContainer = document.getElementById(`choices-list-${questionIndex}`)
                    || document.querySelector(`.question-card[data-index="${questionIndex}"] .choices-list`);
                if (!choicesContainer) return;

                const items = Array.from(choicesContainer.querySelectorAll('.choice-item'));
                items.forEach((item, cIndex) => {
                    item.querySelectorAll('[name]').forEach(el => {
                        el.name = el.name.replace(/Choices\[\d+\]/g, `Choices[${cIndex}]`)
                                         .replace(/Questions\[\d+\]/g, `Questions[${questionIndex}]`);
                    });
                    const btn = item.querySelector('button');
                    if (btn) btn.setAttribute('onclick', `removeChoice(${questionIndex}, ${cIndex})`);
                });

                // ensure single-choice containers (short answer / essay) have Choices[0] as name if present
                const correct = document.getElementById(`correct-answer-${questionIndex}`);
                if (correct) {
                    correct.querySelectorAll('[name]').forEach(el => {
                        el.name = el.name.replace(/Questions\[\d+\]/g, `Questions[${questionIndex}]`)
                                         .replace(/Choices\[\d+\]/g, `Choices[0]`);
                    });
                }
                const essay = document.getElementById(`essay-${questionIndex}`);
                if (essay) {
                    essay.querySelectorAll('[name]').forEach(el => {
                        el.name = el.name.replace(/Questions\[\d+\]/g, `Questions[${questionIndex}]`)
                                         .replace(/Choices\[\d+\]/g, `Choices[0]`);
                    });
                }
            }

            function toggleChoices(questionIndex) {
                const sel = document.querySelector(`[name="Questions[${questionIndex}].QuestionType"]`) ||
                            document.querySelector(`.question-card[data-index="${questionIndex}"] select.question-type`);
                if (!sel) return;
                const val = parseInt(sel.value);

                const choices = document.getElementById(`choices-${questionIndex}`);
                const correct = document.getElementById(`correct-answer-${questionIndex}`);
                const essay = document.getElementById(`essay-${questionIndex}`);
                const autoGrade = document.getElementById(`auto-grade-${questionIndex}`);

                if (choices) choices.style.display = 'none';
                if (correct) correct.style.display = 'none';
                if (essay) essay.style.display = 'none';
                if (autoGrade) autoGrade.style.display = 'none';

                if (val === 0 || val === 1) {
                    if (choices) choices.style.display = '';
                    if (val === 1) addTrueFalseChoices(questionIndex);
                } else if (val === 2) {
                    if (correct) correct.style.display = '';
                    if (autoGrade) autoGrade.style.display = '';
                } else if (val === 3) {
                    if (essay) essay.style.display = '';
                    if (autoGrade) autoGrade.style.display = '';
                }
            }

            function addTrueFalseChoices(questionIndex) {
                const list = document.getElementById(`choices-list-${questionIndex}`)
                            || document.querySelector(`.question-card[data-index="${questionIndex}"] .choices-list`);
                if (!list) return;
                if (list.children.length > 0) return;

                const options = [
                    { text: "True", isCorrect: true },
                    { text: "False", isCorrect: false }
                ];

                options.forEach((opt, idx) => {
                    const html = `
                        <div class="choice-item input-group mb-2">
                            <div class="input-group-text">
                                <input name="Questions[${questionIndex}].Choices[${idx}].IsCorrect" type="checkbox" class="form-check-input" ${opt.isCorrect ? "checked" : ""} />
                            </div>
                            <input name="Questions[${questionIndex}].Choices[${idx}].Text" type="text" class="form-control" value="${opt.text}" readonly />
                            <button type="button" class="btn btn-outline-danger" onclick="removeChoice(${questionIndex}, ${idx})">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>`;
                    list.insertAdjacentHTML('beforeend', html);
                });

                reindexChoices(questionIndex);
            }

            // init: ensure existing questions are consistent
            (function initPerQuestion() {
                const cards = Array.from(document.querySelectorAll('.question-card'));
                cards.forEach((card, idx) => {
                    if (!card.hasAttribute('data-index')) card.setAttribute('data-index', idx);

                    const choices = card.querySelector('.choices-list');
                    if (choices && !choices.id) choices.id = `choices-list-${idx}`;
                    const choicesContainer = card.querySelector('.choices-container');
                    if (choicesContainer && !choicesContainer.id) choicesContainer.id = `choices-${idx}`;
                    const correct = card.querySelector('.correct-answer-container');
                    if (correct && !correct.id) correct.id = `correct-answer-${idx}`;
                    const essay = card.querySelector('.essay-container');
                    if (essay && !essay.id) essay.id = `essay-${idx}`;
                    const autoGrade = card.querySelector('.auto-grade-toggle');
                    if (autoGrade && !autoGrade.id) autoGrade.id = `auto-grade-${idx}`;

                    const typeSel = card.querySelector('.question-type, select[name*="QuestionType"]');
                    if (typeSel) {
                        typeSel.setAttribute('onchange', `toggleChoices(${idx})`);
                        toggleChoices(idx);
                    }

                    const addBtn = card.querySelector('button[onclick*="addChoice"], .choices-container button');
                    if (addBtn) addBtn.setAttribute('onclick', `addChoice(${idx})`);

                    const rmBtn = card.querySelector('.card-header .btn-danger');
                    if (rmBtn) rmBtn.setAttribute('onclick', `removeQuestion(${idx})`);

                    reindexChoices(idx);
                });
            })();
        });
    </script>
}