@model List<Quizzly.Business.ViewModels.Instructor.ManualGradingListDto>

@{
    ViewData["Title"] = "Manual Grading";
}

<h2 class="mb-4">Manual Grading Dashboard</h2>

<table class="table table-striped table-bordered align-middle shadow-sm">
    <thead class="table-dark">
        <tr>
            <th>#</th>
            <th>Student Name</th>
            <th>Quiz Title</th>
            <th>Status</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            int i = 1;
            foreach (var item in Model)
            {
                <tr>
                    <td>@i</td>
                    <td>@item.StudentName</td>
                    <td>@item.QuizTitle</td>
                    <td>
                        @if (item.IsGraded)
                        {
                            <span class="badge bg-success">Graded</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">Pending</span>
                        }
                    </td>
                    <td>
                        <a href="@Url.Action("Attempt", "ManualGrading", new { attemptId = item.AttemptId })"
                           class="btn btn-primary btn-sm">
                            Grade Now
                        </a>
                    </td>
                </tr>
                i++;
            }
        }
        else
        {
            <tr>
                <td colspan="5" class="text-center text-muted py-4">
                    No pending attempts to grade.
                </td>
            </tr>
        }
    </tbody>
</table>
