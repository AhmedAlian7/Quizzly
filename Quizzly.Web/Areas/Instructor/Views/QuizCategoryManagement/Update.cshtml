@using Quizzly.Business.ViewModels.QuizCategories
@model AddQuizCategoryDto

@{
    ViewData["Title"] = "Update Quiz Category";
}

<div class="container mt-4 mb-5">
    <h2 class="mb-4 fw-bold text-primary">Update Quiz Category</h2>

    <form asp-action="Update" asp-controller="QuizCategoryManagement" asp-area="Instructor" method="post" enctype="multipart/form-data" class="bg-white p-4 rounded shadow-sm border">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <!-- Category Information -->
        <div class="mb-3">
            <label asp-for="Name" class="form-label fw-semibold">Category Name</label>
            <input asp-for="Name" class="form-control" placeholder="Enter category name" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label fw-semibold">Description</label>
            <textarea asp-for="Description" class="form-control" rows="4" placeholder="Enter a short description about this category..."></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="d-flex justify-content-between mt-4">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Back to Categories
            </a>
            <button type="submit" class="btn btn-primary px-4">
                <i class="bi bi-save"></i> Update Category
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
