@using Quizzly.Business.ViewModels.QuizCategories
@model IEnumerable<AddQuizCategoryDto>

@{
    ViewData["Title"] = "Quiz Categories";
}

<div class="container mt-5">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0">Quiz Categories</h2>
            <p class="text-muted">Manage your quiz categories — add, edit, or remove categories.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus"></i> Add New Category
        </a>
    </div>

    <!-- Categories Table -->
    <div class="card shadow-sm">
        <div class="card-body">
            <h5 class="mb-3">Your Categories</h5>

            <!-- Search -->
            <div class="input-group mb-4">
                <span class="input-group-text bg-light border-0">
                    <i class="bi bi-search"></i>
                </span>
                <input type="text" id="categorySearch" class="form-control border-0" placeholder="Search categories...">
            </div>

            <table class="table align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Name</th>
                        <th>Description</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="categoryTableBody">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var category in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@category.Name</td>
                                <td class="text-muted">
                                    @(string.IsNullOrWhiteSpace(category.Description) ? "-" : category.Description)
                                </td>
                                <td>
                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-light" data-bs-toggle="dropdown">
                                            <i class="bi bi-three-dots-vertical"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end">
                                            <li>
                                                <a class="dropdown-item" asp-action="Edit" asp-route-name="@category.Name">Edit</a>
                                            </li>
                                            <li>
                                                <form asp-action="Delete" asp-route-name="@category.Name" method="post" onsubmit="return confirm('Are you sure you want to delete this category?');">
                                                    <button type="submit" class="dropdown-item text-danger">Delete</button>
                                                </form>
                                            </li>
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="text-center text-muted py-4">
                                <i class="bi bi-folder-x"></i> No categories found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Simple search filter for categories
        document.getElementById('categorySearch').addEventListener('input', function () {
            const filter = this.value.toLowerCase();
            const rows = document.querySelectorAll('#categoryTableBody tr');
            rows.forEach(row => {
                const name = row.querySelector('td:first-child')?.innerText.toLowerCase() || '';
                row.style.display = name.includes(filter) ? '' : 'none';
            });
        });
    </script>
}
