@using System.Text.Json
@using Quizzly.Business.ViewModels.Instructor
@using Quizzly.Business.ViewModels.QuizCategories
@model InstructorDashboardDto
@{
    ViewData["Title"] = "Instructor Dashboard";
}

<div class="container py-4">
    <h2 class="fw-bold mb-2">Teacher Dashboard</h2>
    <p class="text-muted mb-4">Overview of your quizzes and student performance</p>

    <!-- Stats Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-3 col-sm-6">
            <div class="card shadow-sm border-0 rounded-3 h-100 text-center">
                <div class="card-body">
                    <h6 class="text-muted">Total Quizzes</h6>
                    <h3 class="fw-bold">@Model.TotalQuizzes</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3 col-sm-6">
            <div class="card shadow-sm border-0 rounded-3 h-100 text-center">
                <div class="card-body">
                    <h6 class="text-muted">Average Score</h6>
                    <h3 class="fw-bold text-primary">
                        @(Model.AvgScore.HasValue ? $"{Model.AvgScore.Value:F1}%" : "N/A")
                    </h3>
                </div>
            </div>
        </div>

        <div class="col-md-3 col-sm-6">
            <div class="card shadow-sm border-0 rounded-3 h-100 text-center">
                <div class="card-body">
                    <h6 class="text-muted">Active Students</h6>
                    <h3 class="fw-bold text-success">@Model.TotalStudents</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3 col-sm-6">
            <div class="card shadow-sm border-0 rounded-3 h-100 text-center">
                <div class="card-body">
                    <h6 class="text-muted">Total Categories</h6>
                    <h3 class="fw-bold text-info">@Model.TotalCategories</h3>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Row -->
    <div class="row g-4 align-items-stretch">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-3 h-100">
                <div class="card-body">
                    <h5 class="mb-3">
                        <i class="bi bi-graph-up"></i> Quiz Performance
                    </h5>
                    <canvas id="quizPerformanceChart" height="180"></canvas>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm border-0 rounded-3 h-100 text-center">
                <div class="card-body">
                    <h5 class="mb-3">
                        <i class="bi bi-bag-dash-fill"></i> Quiz Categories
                    </h5>
                    <canvas id="categoryChart" height="230"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Quizzes + Leaderboard -->
    <div class="row g-4 mt-3">
        <div class="col-md-6">
            <div class="card shadow-sm border-0 rounded-3 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="mb-0">
                            <i class="bi bi-clock-history"></i> Recent Quizzes
                        </h5>
                        <a asp-controller="QuizManagement" asp-action="Index" class="btn btn-sm btn-outline-secondary">View All</a>
                    </div>

                    @if (Model.instructorRecentQuizDtos?.Any() == true)
                    {
                        foreach (var quiz in Model.instructorRecentQuizDtos)
                        {
                            <div class="border-bottom pb-2 mb-2">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <strong>@quiz.Title</strong>
                                        <div>
                                            <span class="badge @(quiz.IsPublished ? "bg-primary" : "bg-secondary")">
                                                @(quiz.IsPublished ? "Published" : "Draft")
                                            </span>
                                            <span class="text-muted ms-2">@quiz.Attempts attempts</span>
                                            @if (quiz.AvgScore.HasValue)
                                            {
                                                <span class="text-muted ms-1">@quiz.AvgScore.Value.ToString("F0")% avg</span>
                                            }
                                        </div>
                                    </div>
                                    <small class="text-muted">@quiz.CreatedAt.ToString("yyyy-MM-dd")</small>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted">No recent quizzes found.</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow-sm border-0 rounded-3 h-100">
                <div class="card-body">
                    <h5 class="mb-3">
                        <i class="bi bi-trophy"></i> Top Performing Students
                    </h5>

                    @if (Model.topPreformingStudentDtos?.Any() == true)
                    {
                        <table class="table table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 60px;">Rank</th>
                                    <th>Student</th>
                                    <th class="text-end">Avg Score</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var student in Model.topPreformingStudentDtos.OrderBy(s => s.Rank))
                                {
                                    <tr>
                                        <td>
                                            @if (student.Rank == 1)
                                            {
                                                <span class="badge bg-warning text-dark">
                                                    <i class="bi bi-trophy-fill"></i> 1
                                                </span>
                                            }
                                            else if (student.Rank == 2)
                                            {
                                                <span class="badge bg-secondary">
                                                    <i class="bi bi-award-fill"></i> 2
                                                </span>
                                            }
                                            else if (student.Rank == 3)
                                            {
                                                <span class="badge bg-info text-dark">
                                                    <i class="bi bi-award"></i> 3
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-light text-dark">@student.Rank</span>
                                            }
                                        </td>
                                        <td>@student.StudentName</td>
                                        <td class="text-end fw-semibold">@($"{student.AvgScore:F1}%")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p class="text-muted">No student data available yet.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        // Serialize complete objects from backend
        var quizPerformanceData = @Html.Raw(JsonSerializer.Serialize(Model.quizPerformanceDtos ?? new List<QuizPerformanceDto>()));
        var categoryData = @Html.Raw(JsonSerializer.Serialize(Model.quizCategoryStatsDtos ?? new List<QuizCategoryStatsDto>()));

        // Extract data using JavaScript map
        var performanceLabels = quizPerformanceData.map(function(q) { return q.QuizTitle; });
        var performanceScores = quizPerformanceData.map(function(q) { return q.AvgScore || 0; });
        var performanceAttempts = quizPerformanceData.map(function(q) { return q.TotalAttempts; });

        var categoryLabels = categoryData.map(function(c) { return c.CategoryName; });
        var categoryCounts = categoryData.map(function(c) { return c.TotalQuizzes; });

        // Initialize Quiz Performance Chart
        if (document.getElementById("quizPerformanceChart")) {
            new Chart(document.getElementById("quizPerformanceChart"), {
                type: 'bar',
                data: {
                    labels: performanceLabels,
                    datasets: [{
                        label: 'Average Score (%)',
                        data: performanceScores,
                        backgroundColor: '#36A2EB'
                    }]
                },
                options: {
                    responsive: true,
                    scales: {
                        y: {
                            beginAtZero: true,
                            title: { display: true, text: 'Score (%)' }
                        }
                    },
                    plugins: { legend: { display: false } }
                }
            });
        }

        // Initialize Category Chart
        if (document.getElementById("categoryChart")) {
            new Chart(document.getElementById("categoryChart"), {
                type: 'doughnut',
                data: {
                    labels: categoryLabels,
                    datasets: [{
                        data: categoryCounts,
                        backgroundColor: ['#36A2EB', '#FFCE56', '#4BC0C0', '#FF6384', '#9966FF']
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: { position: 'bottom' },
                        title: { display: true, text: 'Quizzes per Category' }
                    }
                }
            });
        }
    </script>
}