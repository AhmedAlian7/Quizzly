@model LoginViewModel

@{
    ViewData["Title"] = "Login";
}

@section Styles {

    <link href="~/css/login.css" rel="stylesheet" />
}
<section class="login-container">
    <div class="container">
        <div class="row justify-content-center align-items-center">
            <div class="col-lg-5 col-md-6 d-none d-md-block illustration-side">
                <img src="https://mdbcdn.b-cdn.net/img/Photos/new-templates/bootstrap-login-form/draw2.webp"
                     class="img-fluid" alt="Login illustration">
            </div>
            <div class="col-lg-6 col-md-8 col-sm-12">
                <div class="form-card">
                    <h1 class="form-title">Welcome Back</h1>
                    <p class="form-subtitle">Sign in to continue your learning journey</p>

                    <form asp-action="Login" asp-controller="Account" method="post" novalidate>
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="d-flex flex-column align-items-center mb-4">
                            <p class="text-muted mb-3">Sign in with</p>
                            <div class="d-flex gap-3">
                                <a class="social-login-btn"
                                   href="@Url.Action("ExternalLogin", "Account", new { provider = "Google", returnUrl = Url.Action("Index", "Home") })"
                                   title="Continue with Google"
                                   aria-label="Continue with Google">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 488 512" fill="currentColor" role="img" aria-hidden="true">
                                        <path d="M488 261.8C488 403.3 391.6 512 248 512 111 512 0 401 0 264S111 16 248 16c66.9 0 123 24.6 166.1 65L350 143.1C322.4 117.6 286.6 102.3 248 102.3 150.6 102.3 70.6 181.5 70.6 278S150.6 454 248 454c118.4 0 162.7-84.9 169.6-129.5H248v-103h240C487 235 488 248.4 488 261.8z" />
                                    </svg>
                                </a>
                            </div>
                        </div>

                        <div class="divider d-flex align-items-center my-4">
                            <p class="text-center text-muted mx-3 mb-0">or continue with email</p>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">Email Address</label>
                            <input asp-for="Email" class="form-control" placeholder="you@example.com" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label">Password</label>
                            <input asp-for="Password" class="form-control" placeholder="••••••••" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div class="form-check">
                                <input asp-for="RememberMe" class="form-check-input" />
                                <label asp-for="RememberMe" class="form-check-label">
                                    Remember me
                                </label>
                            </div>
                            <a href="#" class="forgot-password-link">Forgot password?</a>
                        </div>

                        <div class="text-center">
                            <button type="submit" class="btn btn-primary w-100 mb-3">
                                Sign In
                            </button>
                            <p class="text-muted mb-0">
                                Don't have an account? <a href="/Authentication/Account/Register" class="link-primary">Create account</a>
                            </p>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}