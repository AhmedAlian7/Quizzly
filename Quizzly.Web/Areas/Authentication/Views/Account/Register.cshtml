@model RegisterViewModel

@{
    ViewData["Title"] = "Register";
}

@section Styles {
    <link href="~/css/register.css" rel="stylesheet" />
}

<section class="register-container">
    <div class="container">
        <div class="row justify-content-center align-items-center">
            <div class="col-lg-5 col-md-6 d-none d-md-block illustration-side">
                <img src="https://mdbcdn.b-cdn.net/img/Photos/new-templates/bootstrap-login-form/draw2.webp"
                     class="img-fluid" alt="Registration illustration">
            </div>
            <div class="col-lg-6 col-md-8 col-sm-12">
                <div class="form-card">
                    <h1 class="form-title">Create Account</h1>
                    <p class="form-subtitle">Join us and start your learning journey</p>

                    <form asp-action="Register" asp-controller="Account" method="post" novalidate>
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="d-flex flex-column align-items-center mb-4">
                            <p class="text-muted mb-3">Sign up with</p>
                            <div class="d-flex gap-3">
                                <a class="social-login-btn"
                                   href="@Url.Action("ExternalLogin", "Account", new { provider = "Google", returnUrl = Url.Action("Index", "Home") })"
                                   title="Continue with Google"
                                   aria-label="Continue with Google">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 488 512" fill="currentColor" role="img" aria-hidden="true">
                                        <path d="M488 261.8C488 403.3 391.6 512 248 512 111 512 0 401 0 264S111 16 248 16c66.9 0 123 24.6 166.1 65L350 143.1C322.4 117.6 286.6 102.3 248 102.3 150.6 102.3 70.6 181.5 70.6 278S150.6 454 248 454c118.4 0 162.7-84.9 169.6-129.5H248v-103h240C487 235 488 248.4 488 261.8z" />
                                    </svg>
                                </a>
                            </div>
                        </div>

                        <div class="divider d-flex align-items-center my-4">
                            <p class="text-center text-muted mx-3 mb-0">or continue with email</p>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="FirstName" class="form-label">First Name</label>
                                <input asp-for="FirstName" class="form-control" placeholder="Omar" />
                                <span asp-validation-for="FirstName" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="LastName" class="form-label">Last Name</label>
                                <input asp-for="LastName" class="form-control" placeholder="Elsheikh" />
                                <span asp-validation-for="LastName" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">Email Address</label>
                            <input asp-for="Email" class="form-control" placeholder="you@example.com" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label">Password</label>
                            <input asp-for="Password" class="form-control" placeholder="••••••••" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ConfirmPassword" class="form-label">Confirm Password</label>
                            <input asp-for="ConfirmPassword" class="form-control" placeholder="••••••••" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Select Your Role</label>
                            <div class="role-selection">
                                <label class="role-card" for="roleInstructor">
                                    <input type="radio" asp-for="Role" value="Instructor" id="roleInstructor" />
                                    <div class="role-content">
                                        <div class="role-icon">👨‍🏫</div>
                                        <div class="role-title">Instructor</div>
                                        <div class="role-description">Create and manage quizzes</div>
                                    </div>
                                    <div class="role-checkmark"></div>
                                </label>

                                <label class="role-card" for="roleStudent">
                                    <input type="radio" asp-for="Role" value="Student" id="roleStudent" />
                                    <div class="role-content">
                                        <div class="role-icon">🎓</div>
                                        <div class="role-title">Student</div>
                                        <div class="role-description">Take and track your quizzes</div>
                                    </div>
                                    <div class="role-checkmark"></div>
                                </label>
                            </div>
                            <span asp-validation-for="Role" class="text-danger"></span>
                        </div>

                        <div class="role-dependent-field mb-3" id="instructorTitleDiv" style="display:none;">
                            <label asp-for="InstructorTitle" class="form-label">Title</label>
                            <input asp-for="InstructorTitle" class="form-control" placeholder="e.g., Professor, Lecturer" />
                            <span asp-validation-for="InstructorTitle" class="text-danger"></span>
                        </div>

                        <div class="role-dependent-field mb-3" id="studentNumberDiv" style="display:none;">
                            <label asp-for="StudentNumber" class="form-label">Student Number</label>
                            <input asp-for="StudentNumber" class="form-control" placeholder="Enter your student ID" />
                            <span asp-validation-for="StudentNumber" class="text-danger"></span>
                        </div>

                        <div class="form-check mb-4">
                            <input asp-for="AcceptTerms" class="form-check-input" />
                            <label asp-for="AcceptTerms" class="form-check-label">
                                I agree to the <a href="#" class="link-primary">Terms & Conditions</a>
                            </label>
                            <span asp-validation-for="AcceptTerms" class="text-danger d-block"></span>
                        </div>

                        <div class="text-center">
                            <button type="submit" class="btn btn-primary w-100 mb-3">
                                Create Account
                            </button>
                            <p class="text-muted mb-0">
                                Already have an account? <a href="/Authentication/Account/Login" class="link-primary">Sign in</a>
                            </p>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const roleRadios = document.querySelectorAll('input[name="Role"]');
            const instructorDiv = document.getElementById('instructorTitleDiv');
            const studentDiv = document.getElementById('studentNumberDiv');
            const roleCards = document.querySelectorAll('.role-card');

            function updateRoleSelection() {
                const selectedRole = document.querySelector('input[name="Role"]:checked');

                // Update card styles
                roleCards.forEach(card => card.classList.remove('selected'));
                if (selectedRole) {
                    selectedRole.closest('.role-card').classList.add('selected');
                }

                // Show/hide role-specific fields
                const value = selectedRole ? selectedRole.value : '';
                instructorDiv.style.display = value === 'Instructor' ? 'block' : 'none';
                studentDiv.style.display = value === 'Student' ? 'block' : 'none';
            }

            roleRadios.forEach(radio => {
                radio.addEventListener('change', updateRoleSelection);
            });

            // Initialize on page load
            updateRoleSelection();
        });
    </script>
}