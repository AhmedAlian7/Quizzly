@model Quizzly.Business.ViewModels.Student.StudentAccessViewModel
@{
    ViewData["Title"] = "Quiz Access";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h2 class="h4 mb-1 text-primary">@Model.Title</h2>
                    <p class="text-muted mb-3">@Model.Description</p>
                    <div class="mb-3">
                        <span class="badge bg-light text-dark">Instructor: @Model.InstructorName</span>
                        <span class="badge bg-light text-dark ms-2">Duration: @Model.DurationMinutes min</span>
                    </div>

                    <div class="alert alert-info">
                        <strong>Instructions:</strong>
                        <ul class="mb-0">
                            <li>The timer starts immediately when you click Start.</li>
                            <li>Auto-submit when time ends.</li>
                            <li>Don’t close or refresh the page while taking the quiz.</li>
                        </ul>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.ValidationMessage))
                    {
                        <div class="alert alert-warning">@Model.ValidationMessage</div>
                        <a class="btn btn-secondary" href="@Url.Action("Index","Home", new { area = "Instructor" })">Back</a>
                    }
                    else
                    {
                        <div class="d-flex gap-2">
                            <a class="btn btn-primary" href="#" id="startQuizBtn" data-url="@Url.Action("Start", "Quiz", new { area = "Student", token = Model.AccessToken })">Start Quiz</a>
                            <a class="btn btn-outline-secondary" href="@Url.Action("Index", "Home", new { area = "Instructor" })">Cancel</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>


<script>
    document.getElementById('startQuizBtn').addEventListener('click', function(e) {
        e.preventDefault();
        const url = this.getAttribute('data-url');

        Swal.fire({
            icon: 'info',
            title: 'Ready to Begin?',
            html: '<p class="mb-2">The timer will start immediately</p><p class="text-muted small">Make sure you\'re ready before proceeding</p>',
            showCancelButton: true,
            confirmButtonText: '<i class="bi bi-play-fill"></i> Start Quiz',
            cancelButtonText: 'Not Yet',
            confirmButtonColor: '#0d6efd',
            cancelButtonColor: '#6c757d',
            reverseButtons: true,
            backdrop: true,
            allowOutsideClick: false,
            customClass: {
                confirmButton: 'btn btn-primary px-4',
                cancelButton: 'btn btn-secondary px-4'
            },
            buttonsStyling: false
        }).then((result) => {
            if (result.isConfirmed) {
                // Show loading while redirecting
                Swal.fire({
                    title: 'Starting Quiz...',
                    text: 'Please wait',
                    allowOutsideClick: false,
                    allowEscapeKey: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });

                window.location.href = url;
            }
        });
    });
</script>