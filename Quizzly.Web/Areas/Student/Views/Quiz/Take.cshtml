@model Quizzly.Business.ViewModels.Student.QuizTakingViewModel
@{
    ViewData["Title"] = Model.QuizTitle;
}

<div class="border-bottom bg-white position-sticky top-0" style="z-index: 1000;">
    <div class="container py-3 d-flex align-items-center justify-content-between">
        <div class="fw-semibold">@Model.QuizTitle</div>
        <div class="text-center">
            <span class="small text-muted">Remaining Time</span>
            <div id="timer" class="fw-bold"></div>
        </div>
        <form method="post" asp-action="Submit" asp-route-attemptId="@Model.AttemptId">
            <button class="btn btn-danger">Submit Quiz</button>
        </form>
    </div>
</div>

<div class="container py-4">
    <!-- Question Navigation Bar -->
    <div class="mb-3">
        <nav aria-label="Question navigation">
            <ul class="pagination justify-content-center">
                @for (int i = 0; i < Model.TotalQuestions; i++)
                {
                    <li class="page-item @(i == Model.CurrentIndex ? "active" : "")">
                        <a class="page-link" href="@Url.Action("Take","Quiz", new { area = "Student", attemptId = Model.AttemptId, questionId = Model.Questions[i].QuestionId })">@(i + 1)</a>
                    </li>
                }
            </ul>
        </nav>
    </div>

    <div class="mb-3 text-muted">Question @(Model.CurrentIndex + 1) of @Model.TotalQuestions</div>

    @{
        var q = Model.Questions[Model.CurrentIndex];
    }
    @await Html.PartialAsync("_Question", q)

    <div class="d-flex justify-content-between mt-4">
        <a class="btn btn-outline-secondary" href="@Url.Action("Take","Quiz", new { area = "Student", attemptId = Model.AttemptId, questionId = Model.Questions[Math.Max(0, Model.CurrentIndex - 1)].QuestionId })" @(Model.CurrentIndex == 0 ? "aria-disabled=\"true\" tabindex=\"-1\"" : "")>Previous</a>
        <a class="btn btn-primary" id="nextBtn" href="@Url.Action("Take","Quiz", new { area = "Student", attemptId = Model.AttemptId, questionId = Model.Questions[Math.Min(Model.TotalQuestions - 1, Model.CurrentIndex + 1)].QuestionId })">@(Model.CurrentIndex == Model.TotalQuestions - 1 ? "Review" : "Next")</a>
    </div>
</div>

<script>
    // Client-side answer cache, prefill, and attach on submit
    (function(){
        const ATTEMPT_ID = @Model.AttemptId;
        const STORAGE_KEY = 'quizzly_answers_' + ATTEMPT_ID;
        const container = document.querySelector('.question-body');
        if(!container) return;
        const qid = parseInt(container.getAttribute('data-question-id'));

        function readAll(){ try{ return JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]'); }catch(e){ return []; } }
        function writeAll(arr){ try{ localStorage.setItem(STORAGE_KEY, JSON.stringify(arr)); }catch(e){} }
        function upsertAnswer(rec){
            const arr = readAll();
            const idx = arr.findIndex(x => x.questionId === rec.questionId);
            if (idx >= 0) arr.splice(idx, 1);
            arr.push(rec);
            writeAll(arr);
        }
        function prefill(){
            const arr = readAll();
            const rec = arr.find(x => x.questionId === qid);
            if (!rec) return;
            if (rec.choiceId != null) {
                const input = container.querySelector('input.question-choice[value="' + rec.choiceId + '"]');
                if (input) input.checked = true;
            }
            if (rec.textAnswer) {
                const ta = container.querySelector('.question-text');
                if (ta) ta.value = rec.textAnswer;
            }
        }

        container.addEventListener('change', function(e){
            if (e.target.matches('input.question-choice')){
                upsertAnswer({ questionId: qid, choiceId: parseInt(e.target.value), textAnswer: null });
            }
            if (e.target.matches('.question-text')){
                upsertAnswer({ questionId: qid, choiceId: null, textAnswer: e.target.value });
            }
        });

        prefill();

        const submitForm = document.querySelector('form[asp-action="Submit"], form[action*="/Submit"]');
        if (submitForm){
            submitForm.addEventListener('submit', function(){
                const input = document.createElement('input');
                input.type = 'hidden';
                input.name = 'answersJson';
                input.value = JSON.stringify(readAll());
                this.appendChild(input);
            });
        }
    })();
</script>