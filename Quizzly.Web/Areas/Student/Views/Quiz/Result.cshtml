@model Quizzly.Business.ViewModels.Student.QuizResultViewModel
@{
    ViewData["Title"] = "Quiz Result";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h3 class="mb-3">@Model.QuizTitle</h3>

                    <div class="d-flex gap-3 flex-wrap mb-3">
                        @if (Model.ShowScoreImmediately)
                        {
                            <div class="badge bg-primary">Score: @(Model.AutoGradedScore)/@Model.AutoGradedMaxScore (@(Model.AutoGradedPercentage?.ToString("0.##") ?? "0")%)</div>
                        }
                        else
                        {
                            <div class="badge bg-secondary">Score hidden</div>
                        }
                        <div class="badge bg-light text-dark">Time Taken: @Model.TimeTaken.ToString("hh'h 'mm'm 'ss's'")</div>
                        @if (Model.ShowScoreImmediately)
                        {
                            if (Model.Passed)
                            {
                                <div class="badge bg-success">Passed</div>
                            }
                            else
                            {
                                <div class="badge bg-danger">Failed</div>
                            }
                        }
                    </div>

                    @if (Model.AwaitingManualGrading)
                    {
                        <div class="alert alert-info">Your quiz is pending manual grading for short answer/essay questions. Final score may change after instructor review.</div>
                    }

                    @if (Model.ShowCorrectAnswers)
                    {
                        <h5 class="mt-4">Feedback</h5>
                        <hr />
                        @foreach (var q in Model.Questions)
                        {
                            var isCorrect = q.IsCorrect == true;
                            <div class="mb-4">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="fw-semibold">@q.Text</span>
                                    @if (q.PointsAwarded.HasValue)
                                    {
                                        <span class="badge @(isCorrect?"bg-success":"bg-danger")">@(isCorrect?"Correct":"Incorrect")</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">Pending grading</span>
                                    }
                                </div>
                                <div class="small text-muted">Points: @(q.PointsAwarded?.ToString() ?? "-")/@q.Points</div>
                                @if (!string.IsNullOrWhiteSpace(q.Explanation)) { <div class="mt-2"><em>@q.Explanation</em></div> }
                                <ul class="mt-2">
                                    @foreach (var c in q.Choices)
                                    {
                                        var chosen = q.SelectedChoiceIds.Contains(c.ChoiceId);
                                        var css = chosen
                                            ? (c.IsCorrect ? "text-success fw-semibold" : "text-danger fw-semibold")
                                            : (c.IsCorrect ? "text-success" : "text-muted");
                                        <li class="@css">
                                            @if (c.IsCorrect)
                                            {
                                                <span>✅</span>
                                            }
                                            else if (chosen)
                                            {
                                                <span>❌</span>
                                            }
                                            <span>@c.Text</span>
                                            @if (chosen && !c.IsCorrect)
                                            {
                                                <span class="ms-2 small text-danger">(your choice)</span>
                                            }
                                            @if (chosen && c.IsCorrect)
                                            {
                                                <span class="ms-2 small text-success">(your choice)</span>
                                            }
                                        </li>
                                    }
                                </ul>
                                @if (!string.IsNullOrWhiteSpace(q.TextAnswer))
                                {
                                    <div><strong>Your answer:</strong> @q.TextAnswer</div>
                                }
                            </div>
                        }
                    }

                    <div class="d-flex gap-2 mt-3">
                        <a class="btn btn-primary" href="@Url.Action("Link","Access", new { area = "Student" })">Back to Access</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


