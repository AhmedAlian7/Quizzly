@{
    ViewData["Title"] = "Join Quiz";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <!-- Header Section -->
            <div class="text-center mb-5">
                <div class="join-quiz-icon mb-4">
                    <i class="bi bi-plus-circle-fill"></i>
                </div>
                <h1 class="h2 fw-bold text-dark mb-3">Join a Quiz</h1>
                <p class="text-muted lead">Enter your quiz access token to join a new quiz session</p>
            </div>

            <!-- Join Quiz Form -->
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-body p-5">
                    <form asp-action="JoinQuiz" method="post" id="joinQuizForm">
                        @Html.AntiForgeryToken()
                        
                        <div class="mb-4">
                            <label for="accessToken" class="form-label fw-semibold">
                                <i class="bi bi-key me-2"></i>Quiz Access Token
                            </label>
                            <div class="input-group input-group-lg">
                                <span class="input-group-text bg-light border-end-0">
                                    <i class="bi bi-shield-lock text-primary"></i>
                                </span>
                                <input type="text" 
                                       class="form-control border-start-0" 
                                       id="accessToken" 
                                       name="accessToken" 
                                       placeholder="Enter your quiz access token"
                                       required
                                       autocomplete="off"
                                       spellcheck="false">
                            </div>
                            <div class="form-text">
                                <i class="bi bi-info-circle me-1"></i>
                                Ask your instructor for the quiz access token
                            </div>
                        </div>

                        <div class="d-grid gap-3">
                            <button type="submit" class="btn btn-primary btn-lg" id="joinBtn">
                                <i class="bi bi-arrow-right-circle me-2"></i>
                                Join Quiz
                            </button>
                            <a href="@Url.Action("Index", "Dashboard", new { area = "Student" })" 
                               class="btn btn-outline-secondary btn-lg">
                                <i class="bi bi-arrow-left me-2"></i>
                                Back to Dashboard
                            </a>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Help Section -->
            <div class="card mt-4 border-0 bg-light">
                <div class="card-body p-4">
                    <h6 class="fw-semibold text-dark mb-3">
                        <i class="bi bi-question-circle me-2"></i>
                        Need Help?
                    </h6>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="d-flex align-items-start">
                                <div class="flex-shrink-0">
                                    <i class="bi bi-1-circle-fill text-primary fs-6"></i>
                                </div>
                                <div class="flex-grow-1 ms-2">
                                    <small class="text-muted">
                                        Contact your instructor to get the quiz access token
                                    </small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="d-flex align-items-start">
                                <div class="flex-shrink-0">
                                    <i class="bi bi-2-circle-fill text-primary fs-6"></i>
                                </div>
                                <div class="flex-grow-1 ms-2">
                                    <small class="text-muted">
                                        Enter the token exactly as provided by your instructor
                                    </small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="d-flex align-items-start">
                                <div class="flex-shrink-0">
                                    <i class="bi bi-3-circle-fill text-primary fs-6"></i>
                                </div>
                                <div class="flex-grow-1 ms-2">
                                    <small class="text-muted">
                                        Make sure you have a stable internet connection
                                    </small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="d-flex align-items-start">
                                <div class="flex-shrink-0">
                                    <i class="bi bi-4-circle-fill text-primary fs-6"></i>
                                </div>
                                <div class="flex-grow-1 ms-2">
                                    <small class="text-muted">
                                        The timer starts immediately when you begin the quiz
                                    </small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
	<link href="~/css/join-quiz.css" rel="stylesheet" />
}

@section Scripts {

	<script src="~/js/join-quiz.js"></script>
}
