@model Quizzly.Business.ViewModels.Student.StudentResultsOverviewViewModel
@{
    ViewData["Title"] = "Quiz Results";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 fw-bold mb-0">Quiz Results</h1>
        <a href="@Url.Action("Index", "Dashboard", new { area = "Student" })" class="btn btn-outline-secondary">
            <i class="bi bi-chevron-left"></i> Back to Dashboard
        </a>
    </div>

    <!-- Summary Cards Row -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="text-primary fs-3"><i class="bi bi-graph-up"></i></div>
                    <div>
                        <div class="text-muted small">Average Score</div>
                        <div class="fs-4 fw-semibold">@Model.AverageScorePercentage.ToString("0.##")%</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="text-info fs-3"><i class="bi bi-patch-check"></i></div>
                    <div>
                        <div class="text-muted small">Quizzes Taken</div>
                        <div class="fs-4 fw-semibold">@Model.CompletedQuizzesCount</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="text-success fs-3"><i class="bi bi-trophy"></i></div>
                    <div>
                        <div class="text-muted small">Best Score</div>
                        <div class="fs-4 fw-semibold">@(Model.BestScorePercentage?.ToString("0.##") ?? "-")%</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="text-warning fs-3"><i class="bi bi-clock-history"></i></div>
                    <div>
                        <div class="text-muted small">Total Time Spent</div>
                        <div class="fs-4 fw-semibold">@((Model.TotalTimeSpent.TotalHours).ToString("0.##"))h</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Attempts Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="h5 fw-semibold mb-0">Recent Attempts</h2>
                <div class="d-flex align-items-center gap-2">
                    <span class="text-muted small">Page @Model.CurrentPage of @Model.TotalPages</span>
                    <span class="text-muted small">(@Model.TotalItems total)</span>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table align-middle table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>Quiz Title</th>
                            <th>Score</th>
                            <th>Questions</th>
                            <th>Duration</th>
                            <th>Date</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.RecentAttempts.Count == 0)
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-4">No attempts yet.</td>
                            </tr>
                        }
                        else
                        {
                            foreach (var a in Model.RecentAttempts.OrderByDescending(x => x.FinishedAt ?? DateTime.UtcNow))
                            {
                                var pct = a.Percentage ?? 0m;
                                string badgeClass = pct > 90 ? "bg-success" : pct > 80 ? "bg-primary" : pct > 70 ? "bg-warning text-dark" : pct > 60 ? "bg-orange" : "bg-danger";
                                string status = a.Status;
                                var durationMinutes = Math.Max(0, (int)Math.Round(a.Duration.TotalMinutes));
                                <tr class="rounded-3">
                                    <td class="fw-medium">@a.QuizTitle</td>
                                    <td>
                                        @if (a.ShowScoreImmediately)
                                        {
                                            <span class="badge @badgeClass rounded-pill">@pct.ToString("0.##")%</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary rounded-pill">Hidden</span>
                                        }
                                    </td>
                                    <td>@a.QuestionsCount</td>
                                    <td>@durationMinutes min</td>
                                    <td>@a.DisplayAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                                    <td>
                                        <span class="badge @(status=="Completed" ? "bg-success-subtle text-success" : status=="Pending Grading" ? "bg-warning-subtle text-warning" : "bg-secondary-subtle text-secondary") rounded-pill">@status</span>
                                    </td>
                                    <td class="text-end">
                                        @switch(status)
                                        {
                                            case "Completed":
                                                <a class="btn btn-sm btn-outline-primary" href="@Url.Action("Result", "Quiz", new { area = "Student", attemptId = a.AttemptId })">View</a>;
                                                break;
                                            case "Pending Grading":
                                                <a class="btn btn-sm btn-outline-secondary disabled" href="#" tabindex="-1" aria-disabled="true">Pending</a>;
                                                break;
                                            default:
                                                <a class="btn btn-sm btn-outline-secondary disabled" href="#" tabindex="-1" aria-disabled="true">Exited</a>;
                                                break;
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            @if (Model.TotalPages > 1)
            {
                <nav aria-label="Results pagination" class="mt-4">
                    <ul class="pagination justify-content-center">
                        @if (Model.CurrentPage > 1)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("Index", new { page = Model.CurrentPage - 1, pageSize = Model.PageSize })" aria-label="Previous">
                                    <span aria-hidden="true">&laquo;</span>
                                </a>
                            </li>
                        }

                        @{
                            var startPage = Math.Max(1, Model.CurrentPage - 2);
                            var endPage = Math.Min(Model.TotalPages, Model.CurrentPage + 2);
                        }

                        @if (startPage > 1)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("Index", new { page = 1, pageSize = Model.PageSize })">1</a>
                            </li>
                            @if (startPage > 2)
                            {
                                <li class="page-item disabled">
                                    <span class="page-link">...</span>
                                </li>
                            }
                        }

                        @for (int i = startPage; i <= endPage; i++)
                        {
                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                <a class="page-link" href="@Url.Action("Index", new { page = i, pageSize = Model.PageSize })">@i</a>
                            </li>
                        }

                        @if (endPage < Model.TotalPages)
                        {
                            @if (endPage < Model.TotalPages - 1)
                            {
                                <li class="page-item disabled">
                                    <span class="page-link">...</span>
                                </li>
                            }
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("Index", new { page = Model.TotalPages, pageSize = Model.PageSize })">@Model.TotalPages</a>
                            </li>
                        }

                        @if (Model.CurrentPage < Model.TotalPages)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("Index", new { page = Model.CurrentPage + 1, pageSize = Model.PageSize })" aria-label="Next">
                                    <span aria-hidden="true">&raquo;</span>
                                </a>
                            </li>
                        }
                    </ul>
                </nav>
            }
        </div>
    </div>
</div>

<style>
    .bg-orange { background-color: #fd7e14; color: #fff; }
    .table tbody tr { border-radius: .5rem; }
    .table-hover tbody tr:hover { background-color: #f8fafc; }
</style>


